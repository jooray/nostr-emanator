    <!-- Accounts that cannot message yet (web: accounts.messaging_repair_list / messaging_banner) -->
    <plurals name="msg_repair_summary">
        <item quantity="one">%d account cannot message yet</item>
        <item quantity="other">%d accounts cannot message yet</item>
    </plurals>
    <string name="msg_repair_hint">Paired before private messaging existed — re-pair to grant it. Posting is unaffected.</string>
    <string name="msg_repair_explanation">Their signers never granted permission to encrypt, seal or decrypt messages. Re-pairing keeps each account\'s posts, schedule and settings.</string>
    <string name="msg_re_pair">Re-pair</string>
    <string name="msg_enable_messaging">Enable messaging</string>

    <!-- Relay authentication (NIP-42) -->
    <plurals name="msg_not_authenticated">
        <item quantity="one">%d account not relay-authenticated</item>
        <item quantity="other">%d accounts not relay-authenticated</item>
    </plurals>
    <plurals name="msg_still_arrive">
        <item quantity="one">Messages still arrive through your other relays — anything stored only on this one may be missing.</item>
        <item quantity="other">Messages still arrive through your other relays — anything stored only on these may be missing.</item>
    </plurals>
    <string name="msg_auth_explainer">These relays hand your messages only to an authenticated client, and your signer has not completed that handshake yet.</string>
    <string name="msg_auth_missed_prompt">If Amber prompted you and you missed it, just wait — it retries. When it asks, Authentication scope → All relays stops it asking again.</string>
    <string name="msg_auth_whitelist">If it never prompts, check Settings → Client auth whitelist in Amber. While that list is non-empty, Amber rejects relay-auth requests from any host that is not on it, without asking. Either add %1$s to the list, or clear the list so Amber asks you instead.</string>

