<div class="space-y-6" data-controller="interactions-filter"
     data-interactions-filter-account-ids-value="<%= @accounts.map(&:id).to_json %>">
  <header class="mb-5 border-b rule pb-4">
    <h1 class="condensed text-[33px] font-bold uppercase leading-none tracking-[0.06em]"><%= t(".title") %></h1>
    <p class="eng mt-2.5"><%= t(".subtitle", count: @accounts.size) %></p>
  </header>

  <!-- Account Filter Tabs -->
  <% if @accounts.size > 1 %>
    <div class="mb-5 flex flex-wrap items-center gap-1.5">
      <button data-interactions-filter-target="toggleAllButton"
              data-action="interactions-filter#toggleAll"
              class="condensed cursor-pointer border border-gray-300 px-3 py-1.5 text-[13px] font-semibold uppercase tracking-[0.14em] text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400">
        <%= t(".unselect_all") %>
      </button>
      <% @accounts.each do |account| %>
        <button data-interactions-filter-target="accountButton"
                data-account-id="<%= account.id %>"
                data-action="interactions-filter#toggleAccount"
                class="condensed inline-flex cursor-pointer items-center gap-2 border border-gray-900 px-2.5 py-1.5 text-[13px] font-semibold uppercase tracking-[0.14em] text-gray-900 transition-colors dark:border-gray-100 dark:text-gray-100">
          <span class="inline-block h-3 w-[3px] flex-none" style="background: <%= account.ink %>"></span>
          <% if account.picture_url.present? %>
            <img src="<%= account.picture_url %>" alt="" class="h-4 w-4 flex-none object-cover">
          <% end %>
          <%= account.display_name.presence || account.username.presence || account.npub&.truncate(12) %>
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Turbo Stream subscription for async updates -->
  <%= turbo_stream_from @stream_name %>

  <!-- Loading toast: visible while FetchInteractionsJob is in flight; cleared by the job's final broadcast. -->
  <%= render "interactions/loading_toast", refreshing: @refreshing %>

  <!-- Interactions Content — cached render on load, replaced by background job on refresh -->
  <% if @interactions.present? %>
    <%= render "interactions/interactions_content", interactions: @interactions %>
  <% else %>
    <div id="interactions_content" data-interactions-filter-target="content">
      <div class="space-y-3">
        <% 5.times do %>
          <div class="border rule overflow-hidden">
            <div class="p-4 animate-pulse">
              <div class="mb-3 pl-3 border-l border-gray-200 dark:border-[color:var(--color-rule-dark)]">
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-2/3 mb-1"></div>
                <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
              </div>
              <div class="flex items-start gap-3">
                <div class="h-10 w-10 rounded-full bg-gray-200 dark:bg-gray-700 flex-shrink-0"></div>
                <div class="flex-1 space-y-2">
                  <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/4"></div>
                  <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-3/4"></div>
                  <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
