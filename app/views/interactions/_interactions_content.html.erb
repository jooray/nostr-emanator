<div id="interactions_content" data-interactions-filter-target="content">
  <% if interactions.present? && interactions.any? %>
    <div class="space-y-3">
      <% interactions.each do |interaction| %>
        <%= render "interactions/interaction_card", interaction: interaction %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-12 text-center border border-gray-200 dark:border-gray-700">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-white">No interactions yet</h3>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        Interactions from others will appear here as they reply to, quote, or mention your accounts.
      </p>
    </div>
  <% end %>
</div>
