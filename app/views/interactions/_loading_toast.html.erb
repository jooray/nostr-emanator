<div id="interactions_loading_toast" class="<%= 'fixed bottom-4 right-4 z-40 flex items-center gap-2 px-3 py-2 rounded-lg shadow-lg bg-gray-900/90 dark:bg-gray-700/90 text-white text-sm border border-amber-500/40' if refreshing %>">
  <% if refreshing %>
    <svg class="h-4 w-4 animate-spin text-amber-400" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
    </svg>
    <span>Loading latest interactions…</span>
  <% end %>
</div>
