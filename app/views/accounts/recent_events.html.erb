<%= turbo_frame_tag "recent_events" do %>
  <% if @recent_events.present? && @recent_events.any? %>
    <ul class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @recent_events.each do |event| %>
        <li class="px-6 py-4">
          <p class="text-sm text-gray-900 dark:text-gray-100 whitespace-pre-wrap break-words"><%= render_nostr_content(event["content"]&.truncate(500)) %></p>
          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400 dark:text-gray-500">
            <span><%= local_time(Time.at(event["created_at"])) %></span>
            <% if event["id"].present? %>
              <% nevent = Nostr::KeyConverter.hex_to_nevent(event["id"], author_pubkey: event["pubkey"]) %>
              <a href="<%= nevent_url(nevent) %>" target="_blank" rel="noopener noreferrer"
                 class="hover:text-amber-600 dark:hover:text-amber-400 underline underline-offset-2 transition-colors"><%= t("posts.show.view_on", viewer: current_user.event_viewer.capitalize) %></a>
              <%= render "shared/copy_nevent", nevent: nevent %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="px-6 py-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= t(".empty") %></p>
    </div>
  <% end %>
<% end %>
