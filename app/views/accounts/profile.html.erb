<%#
  Nostr profile editor. Amber has no profile editor of its own — its
  EditProfileScreen only sets a local nickname — so for a paired account this is
  the only place the published kind 0 can be changed.

  The preview is not decoration. A kind 0 is rendered by other people's clients,
  in a shape the author never sees while typing: a wide banner, a round avatar
  punched over it, a display name and a handle that are two different fields.
  Getting a banner crop wrong is invisible in a form and obvious in Damus, so
  the preview mirrors the real geometry rather than approximating it.
%>
<div class="max-w-5xl mx-auto" data-controller="profile-editor"
     data-profile-editor-upload-url-value="<%= account_blossom_uploads_path(@account) %>"
     data-profile-editor-publish-url-value="<%= profile_account_path(@account) %>">

  <div class="mb-6">
    <%= link_to settings_account_path(@account), class: "text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200" do %>
      &larr; Back to <%= @account.display_name.presence || @account.username.presence || "account" %>
    <% end %>
    <h1 class="mt-2 text-2xl font-semibold text-gray-900 dark:text-gray-100">Nostr profile</h1>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      Published as kind&nbsp;0 and signed in your signer app. Emanator never sees your key.
    </p>
  </div>

  <% unless @account.profile_editing_capable? %>
    <%# Accounts paired before permission version 4 never requested sign_event:0.
        Say what to do, not just what is wrong. %>
    <div class="mb-6 rounded-lg border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-900/20 p-4" role="alert">
      <p class="text-sm text-amber-900 dark:text-amber-200">
        This account was paired before profile editing existed, so its signer has not
        granted permission to publish a profile.
      </p>
      <%= link_to "Re-pair this account", re_pair_account_path(@account),
            class: "mt-3 inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-amber-700 hover:bg-amber-800 text-white text-sm font-medium" %>
    </div>
  <% end %>

  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <%# Form second in the DOM on small screens would bury it; instead the
        preview is ordered first only from lg up, where it can sit alongside. %>
    <form class="order-2 lg:order-1 space-y-6" data-action="submit->profile-editor#publish">
      <div class="border rule p-6 space-y-5">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Identity</h2>

        <div>
          <label for="pf-display_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Display name</label>
          <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Shown in bold. Can contain spaces and emoji.</p>
          <input type="text" id="pf-display_name" name="profile[display_name]"
                 value="<%= @profile["display_name"] %>"
                 maxlength="120"
                 class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                 data-profile-editor-target="displayName" data-action="input->profile-editor#sync">
        </div>

        <div>
          <label for="pf-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Handle</label>
          <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Short username, no spaces. Shown as @handle.</p>
          <input type="text" id="pf-name" name="profile[name]"
                 value="<%= @profile["name"] %>"
                 maxlength="60" autocapitalize="none" autocorrect="off" spellcheck="false"
                 class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                 data-profile-editor-target="name" data-action="input->profile-editor#sync">
        </div>

        <div>
          <label for="pf-about" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Bio</label>
          <textarea id="pf-about" name="profile[about]" rows="4" maxlength="1000"
                    class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                    data-profile-editor-target="about" data-action="input->profile-editor#sync"><%= @profile["about"] %></textarea>
        </div>
      </div>

      <div class="border rule p-6 space-y-5">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Images</h2>

        <%= render "accounts/profile_image_field",
              field: "picture", label: "Avatar",
              hint: "Square. Shown as a circle in most clients.",
              value: @profile["picture"], account: @account %>

        <%= render "accounts/profile_image_field",
              field: "banner", label: "Banner",
              hint: "Wide. Clients crop it to roughly 3:1, so keep anything important centred.",
              value: @profile["banner"], account: @account %>
      </div>

      <div class="border rule p-6 space-y-5">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Links</h2>

        <div>
          <label for="pf-website" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Website</label>
          <input type="url" id="pf-website" name="profile[website]" value="<%= @profile["website"] %>"
                 placeholder="https://example.com" inputmode="url" autocapitalize="none" spellcheck="false"
                 class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                 data-profile-editor-target="website" data-action="input->profile-editor#sync">
        </div>

        <div>
          <label for="pf-nip05" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Nostr address (NIP-05)</label>
          <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Looks like an email. Verified by the domain, not by us.</p>
          <input type="text" id="pf-nip05" name="profile[nip05]" value="<%= @profile["nip05"] %>"
                 placeholder="you@example.com" inputmode="email" autocapitalize="none" spellcheck="false"
                 class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                 data-profile-editor-target="nip05" data-action="input->profile-editor#sync">
        </div>

        <div>
          <label for="pf-lud16" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Lightning address</label>
          <input type="text" id="pf-lud16" name="profile[lud16]" value="<%= @profile["lud16"] %>"
                 placeholder="you@walletofsatoshi.com" inputmode="email" autocapitalize="none" spellcheck="false"
                 class="mt-2 w-full rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
                 data-profile-editor-target="lud16" data-action="input->profile-editor#sync">
        </div>
      </div>

      <%# Anything in the published profile this form does not model survives the
          edit — worth saying, because the opposite is the usual behaviour. %>
      <p class="text-xs text-gray-500 dark:text-gray-400">
        Fields set by other clients that are not shown here are kept as they are.
      </p>

      <div class="flex items-center gap-3">
        <button type="submit"
                class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-amber-700 hover:bg-amber-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 text-white font-medium transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
                data-profile-editor-target="publishButton"
                <%= "disabled" unless @account.profile_editing_capable? %>>
          <span data-profile-editor-target="publishLabel">Publish profile</span>
        </button>
        <p class="text-sm text-gray-500 dark:text-gray-400" data-profile-editor-target="status" role="status"></p>
      </div>

      <div class="hidden rounded-lg bg-red-50 dark:bg-red-900/20 p-4" data-profile-editor-target="errorBox" role="alert">
        <p class="text-sm text-red-700 dark:text-red-300" data-profile-editor-target="errorText"></p>
      </div>
    </form>

    <%# --- Live preview ------------------------------------------------------ %>
    <div class="order-1 lg:order-2">
      <div class="lg:sticky lg:top-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
          How it looks
        </h2>

        <div class="border rule overflow-hidden">
          <%# Real geometry, not an approximation: ~3:1 banner with the avatar
              punched over its lower edge is what clients actually render, and
              it is the only way a bad crop is visible before publishing. %>
          <div class="relative">
            <div class="w-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-600" style="aspect-ratio: 3 / 1;">
              <img data-profile-editor-target="previewBanner"
                   src="<%= @profile["banner"] %>"
                   alt=""
                   class="<%= "hidden" if @profile["banner"].blank? %> w-full h-full object-cover"
                   data-action="error->profile-editor#imageFailed">
            </div>
            <div class="absolute left-4 -bottom-8">
              <div class="h-16 w-16 rounded-full ring-4 ring-white dark:ring-gray-800 bg-gray-300 dark:bg-gray-600 overflow-hidden flex items-center justify-center">
                <img data-profile-editor-target="previewAvatar"
                     src="<%= @profile["picture"] %>"
                     alt=""
                     class="<%= "hidden" if @profile["picture"].blank? %> h-full w-full object-cover"
                     data-action="error->profile-editor#imageFailed">
                <span data-profile-editor-target="previewAvatarFallback"
                      class="<%= "hidden" if @profile["picture"].present? %> text-lg font-semibold text-gray-600 dark:text-gray-300"></span>
              </div>
            </div>
          </div>

          <div class="pt-10 px-4 pb-5">
            <p class="text-base font-semibold text-gray-900 dark:text-gray-100 break-words" data-profile-editor-target="previewDisplayName"></p>
            <p class="text-sm text-gray-500 dark:text-gray-400 break-words" data-profile-editor-target="previewHandle"></p>
            <p class="mt-1 text-xs text-amber-700 dark:text-amber-400 break-all" data-profile-editor-target="previewNip05"></p>
            <p class="mt-3 text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap break-words" data-profile-editor-target="previewAbout"></p>
            <%# Drawn icons rather than 🔗/⚡: emoji render in a different family
                at a different weight on every platform and do not belong to the
                app's icon set. %>
            <div class="mt-3 space-y-1.5">
              <div class="hidden flex items-start gap-1.5" data-profile-editor-target="previewWebsiteRow">
                <svg class="h-3.5 w-3.5 shrink-0 mt-px text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
                <p class="text-xs text-gray-500 dark:text-gray-400 break-all" data-profile-editor-target="previewWebsite"></p>
              </div>
              <div class="hidden flex items-start gap-1.5" data-profile-editor-target="previewLud16Row">
                <svg class="h-3.5 w-3.5 shrink-0 mt-px text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5z"/>
                </svg>
                <p class="text-xs text-gray-500 dark:text-gray-400 break-all" data-profile-editor-target="previewLud16"></p>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
          Every client styles this differently. The crops and the two name fields are what matter.
        </p>
      </div>
    </div>
  </div>
</div>
