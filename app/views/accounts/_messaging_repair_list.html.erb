<%# Consolidated "these accounts need re-pairing" prompt for the Messages inbox.

    The per-account banner is right on an account's own settings page, but this
    page spans every paired account — and one real user has 20 of them, so
    rendering it once each would bury the inbox under a wall of identical boxes.

    It is also not an alarm. Nothing is broken and nothing was lost; these
    accounts simply predate messaging permissions. So it reads as one engraved
    line with the fix folded behind it, rather than a filled amber panel that
    owns the top of the screen — which is what it used to be, and what the red
    NIP-42 notice below it used to be as well. %>
<% return if accounts.blank? %>

<% if accounts.one? %>
  <%= render "accounts/messaging_banner", account: accounts.first %>
<% else %>
  <details class="border rule">
    <summary class="flex cursor-pointer list-none flex-wrap items-center gap-2.5 px-3 py-2.5">
      <span class="lamp" aria-hidden="true"></span>
      <span class="eng"><%= accounts.size %> accounts cannot message yet</span>
      <span class="text-sm text-gray-500 dark:text-gray-400">
        Paired before private messaging existed — re-pair to grant it. Posting is unaffected.
      </span>
    </summary>

    <div class="border-t rule px-3 py-3">
      <p class="mb-3 max-w-prose text-sm text-gray-600 dark:text-gray-300">
        Their signers never granted permission to encrypt, seal or decrypt messages.
        Re-pairing keeps each account's posts, schedule and settings.
      </p>
      <ul class="space-y-1">
        <% accounts.each do |account| %>
          <li>
            <%= link_to re_pair_account_path(account, reason: "messaging"),
                  class: "flex items-center gap-2.5 py-1.5 hover:text-amber-600 dark:hover:text-amber-400" do %>
              <%= wire(account, height: "16px") %>
              <span class="condensed text-[12px] font-semibold uppercase tracking-[0.13em]"><%= account.display_name_or_npub %></span>
              <span class="eng ml-auto text-amber-600 dark:text-amber-400">Re-pair</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </details>
<% end %>
