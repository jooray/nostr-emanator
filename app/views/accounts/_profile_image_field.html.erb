<%#
  One image field: upload to Blossom, or paste a URL.

  Both paths exist on purpose. Uploading is right when the image only lives on
  your phone; pasting is right when it already lives somewhere — re-uploading
  an image that is already online just creates a second copy that can rot
  independently of the original.
%>
<div data-profile-editor-target="imageField" data-field="<%= field %>">
  <label for="pf-<%= field %>" class="block text-sm font-medium text-gray-700 dark:text-gray-300"><%= label %></label>
  <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400"><%= hint %></p>

  <div class="mt-2 flex gap-2">
    <input type="url" id="pf-<%= field %>" name="profile[<%= field %>]" value="<%= value %>"
           placeholder="https://…" inputmode="url" autocapitalize="none" spellcheck="false"
           class="flex-1 min-w-0 rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 px-3 py-2 text-xs font-mono text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:border-amber-500 focus:outline-none"
           data-profile-editor-target="<%= field %>" data-action="input->profile-editor#sync">

    <button type="button"
            class="shrink-0 px-3 py-2 rounded-lg border border-gray-300 dark:border-[color:var(--color-rule-dark)] text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            data-action="click->profile-editor#pickImage"
            data-field="<%= field %>"
            <%= "disabled" unless account.has_signer? %>>
      Upload
    </button>
  </div>

  <%# Uploading to Blossom needs a kind-24242 event signed by the account's
      signer, so it prompts the signer app exactly like publishing does. %>
  <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400" data-profile-editor-target="<%= field %>Status" role="status"></p>
</div>
