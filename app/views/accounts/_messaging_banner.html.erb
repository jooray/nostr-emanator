<%# Prompts a re-pair for an account that cannot do NIP-17 yet.

    Private messaging needs signer permissions (nip44_encrypt, nip44_decrypt,
    sign_event:13) that no account paired before this feature was granted, and a
    signer cannot be asked what it granted — so this is driven off the permission
    version stamped at pair time. Rendered wherever the absence would otherwise
    look like "messaging is just broken". %>
<% if account.needs_messaging_repair? %>
  <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 dark:border-amber-700 dark:bg-amber-900/30">
    <div class="flex items-start gap-3">
      <svg class="h-5 w-5 flex-shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-amber-900 dark:text-amber-200">
          Messaging is not enabled for <%= account.display_name_or_npub %>
        </p>
        <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
          <% if account.messaging_denied? %>
            Your signer refused a message operation for this account. Re-pair and choose
            <strong>Always</strong> when it asks about decrypting messages.
          <% else %>
            This account was paired before private messaging existed, so its signer has not
            granted permission to encrypt, seal or decrypt messages. Re-pairing keeps your
            posts and settings.
          <% end %>
        </p>
        <%= link_to re_pair_account_path(account, reason: "messaging"),
              class: "mt-3 inline-flex items-center gap-1.5 rounded-md bg-amber-600 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-amber-500" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          Enable messaging
        <% end %>
      </div>
    </div>
  </div>
<% end %>
