<%# "Boost as…" and "Quote as…" under a note from the relays: plain links like
    "View on …". Both leave the lazy turbo frame (_top), so the flash and the
    composer show up. %>
<% link_class = "cursor-pointer list-none select-none underline underline-offset-2 transition-colors hover:text-amber-600 dark:hover:text-amber-400" %>
<% if boosters.any? %>
  <%= render "shared/account_menu", label: t("shared.forme_row.boost_as"), summary_class: link_class, accounts: boosters, top: true,
        href: ->(_account) { boosts_path },
        form_params: ->(account) { { account_id: account.id, event_id: event["id"], pubkey: event["pubkey"], kind: event["kind"] } } %>
<% end %>
<%= render "shared/account_menu", label: t("shared.forme_row.quote_as"), summary_class: link_class, accounts: quoters, top: true,
      href: ->(account) { new_account_post_path(account, quote_nevent: nevent) } %>
