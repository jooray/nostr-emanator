<div class="space-y-6">
  <div class="flex items-center gap-2">
    <%= link_to account_path(@account), class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t(".title") %></h1>
  </div>

  <!-- Read-only Profile Info -->
  <div class="border rule overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-[color:var(--color-rule-dark)]">
      <h3 class="text-lg font-medium text-gray-900 dark:text-white"><%= t(".profile_info") %></h3>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        <%= t(".profile_info_help") %>
      </p>
    </div>
    <div class="px-6 py-4">
      <div class="flex items-start gap-5">
        <% if @account.picture_url.present? %>
          <img src="<%= @account.picture_url %>" alt="<%= @account.display_name_or_npub %>" class="h-16 w-16 rounded-full object-cover flex-shrink-0">
        <% else %>
          <div class="h-16 w-16 flex items-center justify-center flex-shrink-0 flex items-center justify-center border border-gray-400 dark:border-gray-500"><span class="text-xl font-medium condensed font-bold uppercase tracking-wide text-gray-600 dark:text-gray-300"><%= @account.display_name_or_npub[0].upcase %></span></div>
        <% end %>
        <div class="flex-1 min-w-0">
          <dl class="space-y-3">
            <div>
              <dt class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t(".display_name") %></dt>
              <dd class="mt-0.5 text-sm text-gray-900 dark:text-white"><%= @account.display_name.presence || t(".not_set") %></dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t(".username") %></dt>
              <dd class="mt-0.5 text-sm text-gray-900 dark:text-white"><%= @account.username.present? ? "@#{@account.username}" : t(".not_set") %></dd>
            </div>
            <div>
              <dt class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t(".npub") %></dt>
              <dd class="mt-0.5 text-xs text-gray-600 dark:text-gray-400 font-mono break-all"><%= @account.npub %></dd>
            </div>
            <% if @account.about.present? %>
              <div>
                <dt class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t(".about") %></dt>
                <dd class="mt-0.5 text-sm text-gray-900 dark:text-white"><%= @account.about %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Editable Personality Form -->
  <div class="border rule overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-[color:var(--color-rule-dark)]">
      <h3 class="text-lg font-medium text-gray-900 dark:text-white"><%= t(".writing_personality") %></h3>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        <%= t(".writing_personality_help") %>
      </p>
    </div>
    <div class="px-6 py-4">
      <%= render "form", account: @account %>
    </div>
  </div>
</div>
