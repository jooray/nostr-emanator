<div class="space-y-6">
  <div class="flex items-center gap-2">
    <%= link_to accounts_path, class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Pair Account</h1>
  </div>

  <div class="max-w-lg mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8 space-y-6 border border-gray-200 dark:border-gray-700"
         data-controller="account-pairing"
         data-account-pairing-poll-url-value="<%= account_pair_poll_path %>">

      <!-- Instructions -->
      <div class="text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-amber-100 dark:bg-amber-900">
          <svg class="h-6 w-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
        </div>
        <h2 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Connect via NIP-46</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Scan the QR code below with Amber or a compatible NIP-46 signer app to pair this Nostr account.
        </p>
      </div>

      <!-- QR Code -->
      <div id="qr-section">
        <div class="flex justify-center">
          <div class="bg-white p-4 rounded-lg w-full max-w-[18rem] [&>svg]:block [&>svg]:w-full [&>svg]:h-auto">
            <%= @qr_code.as_svg(
              color: "000",
              shape_rendering: "crispEdges",
              module_size: 4,
              standalone: true,
              use_path: true,
              viewbox: true
            ).html_safe %>
          </div>
        </div>

        <details class="mt-4 text-center text-xs text-gray-500 dark:text-gray-400">
          <summary class="cursor-pointer hover:text-gray-700 dark:hover:text-gray-300">Show connection details</summary>
          <div class="mt-2 p-2 bg-gray-100 dark:bg-gray-700 rounded text-left break-all">
            <p class="font-medium mb-1">URI:</p>
            <code class="text-xs select-all"><%= @connect_data[:uri] %></code>
            <p class="font-medium mt-2 mb-1">Relays:</p>
            <code class="text-xs"><%= @connect_data[:relay_urls].join(", ") %></code>
          </div>
        </details>
      </div>

      <!-- Polling Status -->
      <div data-account-pairing-target="status" class="flex items-center justify-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        Waiting for signer connection...
      </div>

      <!-- Pairing Steps -->
      <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
        <h3 class="text-sm font-medium text-gray-900 dark:text-white mb-3">How to pair</h3>
        <ol class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-400 font-medium text-xs">1</span>
            <span>Open your NIP-46 signer app (e.g., Amber on Android)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-400 font-medium text-xs">2</span>
            <span>Scan the QR code or paste the connection URI</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-400 font-medium text-xs">3</span>
            <span>Approve the connection request in your signer</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900 text-amber-600 dark:text-amber-400 font-medium text-xs">4</span>
            <span>The account will be paired automatically once confirmed</span>
          </li>
        </ol>
      </div>
    </div>
  </div>
</div>
