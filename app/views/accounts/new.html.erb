<div class="space-y-6">
  <div class="flex items-center gap-2">
    <%= link_to accounts_path, class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" do %>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Pair Account</h1>
  </div>

  <div class="max-w-lg mx-auto">
    <div class="border rule p-8 space-y-6"
         data-controller="account-pairing"
         data-account-pairing-poll-url-value="<%= account_pair_poll_path %>">

      <!-- Instructions -->
      <div class="text-center">
        <div class="mx-auto flex items-center justify-center h-12 w-12 border border-gray-400 dark:border-gray-500">
          <svg class="h-6 w-6 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
        </div>
        <h2 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Connect via NIP-46</h2>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Scan the QR code below with Amber or a compatible NIP-46 signer app to pair this Nostr account.
        </p>
        <%= render "shared/qr_phishing_warning", caption: "pairs your Nostr key to someone else's Emanator account" %>
      </div>

      <!-- QR Code -->
      <div id="qr-section">
        <%# Pairing has the same problem sign-in had: a phone cannot scan a code
            it is displaying. The deep link hands the URI to a signer on this
            device; the QR stays for scanning from a second one. %>
        <a href="<%= @connect_data[:uri] %>"
           class="mb-4 w-full flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-amber-700 hover:bg-amber-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 text-white font-medium transition-colors">
          <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h6v6M19 7l-8.5 8.5M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/>
          </svg>
          Open in your signer app
        </a>
        <p class="mb-4 text-center text-xs text-gray-500 dark:text-gray-400">
          Or scan with a signer on another device
        </p>

        <div class="flex justify-center">
          <div class="bg-white p-4 rounded-lg w-full max-w-[18rem] [&>svg]:block [&>svg]:w-full [&>svg]:h-auto">
            <%= @qr_code.as_svg(
              color: "000",
              shape_rendering: "crispEdges",
              module_size: 4,
              standalone: true,
              use_path: true,
              viewbox: true
            ).html_safe %>
          </div>
        </div>

        <div class="mt-4 flex items-center gap-2 rounded-lg bg-gray-100 dark:bg-gray-700/60 px-3 py-2">
          <code class="flex-1 min-w-0 truncate font-mono text-xs text-gray-600 dark:text-gray-300 select-all"><%= @connect_data[:uri] %></code>
          <button type="button"
                  class="shrink-0 text-xs font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 rounded"
                  data-controller="clipboard"
                  data-clipboard-text-value="<%= @connect_data[:uri] %>"
                  data-action="click->clipboard#copy">Copy</button>
        </div>

        <%# The requested "create a new account" path. Amber generates the key —
            Emanator never holds one — so this is instructions plus the pairing
            flow that is already on this page, not a key generator. %>
        <details class="mt-4 text-sm text-gray-500 dark:text-gray-400">
          <summary class="cursor-pointer hover:text-gray-700 dark:hover:text-gray-300">
            Don't have a Nostr account yet?
          </summary>
          <div class="mt-3 space-y-2 text-left rounded-lg bg-gray-50 dark:bg-gray-700/40 p-4">
            <p>
              Create one in your signer app, then pair it here. In
              <a href="https://github.com/greenart7c3/Amber" target="_blank" rel="noopener noreferrer"
                 class="text-amber-700 dark:text-amber-400 hover:underline">Amber</a>,
              choose <span class="font-medium text-gray-700 dark:text-gray-300">Generate a new key</span> and back it up
              when it asks.
            </p>
            <p>
              Then come back and use the button above. Once it is paired you can
              set its name, bio and pictures from
              <span class="font-medium text-gray-700 dark:text-gray-300">Nostr Profile</span> in the account's settings.
            </p>
            <p class="text-xs">
              The key stays in your signer. Emanator only ever receives events you have already approved.
            </p>
          </div>
        </details>
      </div>

      <!-- Polling Status -->
      <div data-account-pairing-target="status" class="flex items-center justify-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        Waiting for signer connection...
      </div>

      <!-- Pairing Steps -->
      <div class="border-t border-gray-200 dark:border-[color:var(--color-rule-dark)] pt-6">
        <h3 class="text-sm font-medium text-gray-900 dark:text-white mb-3">How to pair</h3>
        <ol class="space-y-3 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center border border-gray-400 dark:border-gray-500 condensed font-bold text-gray-600 dark:text-gray-300 text-xs tabular">1</span>
            <span>Open your NIP-46 signer app (e.g., Amber on Android)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center border border-gray-400 dark:border-gray-500 condensed font-bold text-gray-600 dark:text-gray-300 text-xs tabular">2</span>
            <span>Scan the QR code or paste the connection URI</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center border border-gray-400 dark:border-gray-500 condensed font-bold text-gray-600 dark:text-gray-300 text-xs tabular">3</span>
            <span>Approve the connection request in your signer</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center border border-gray-400 dark:border-gray-500 condensed font-bold text-gray-600 dark:text-gray-300 text-xs tabular">4</span>
            <span>The account will be paired automatically once confirmed</span>
          </li>
        </ol>
      </div>
    </div>
  </div>
</div>
