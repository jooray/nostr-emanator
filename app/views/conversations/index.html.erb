<div class="space-y-6" data-controller="dm-filter">
  <header class="border-b rule pb-4">
    <h1 class="condensed text-[33px] font-bold uppercase leading-none tracking-[0.06em]">Messages</h1>
    <p class="eng mt-2.5">Private, across every paired identity</p>
  </header>

  <%= render "accounts/messaging_repair_list", accounts: @messaging_accounts %>

  <%# The NIP-42 trap. Some DM inbox relays serve gift wraps only to an
      authenticated client, and a signer that will not sign kind 22242 produces an
      empty inbox with nothing explaining it — so it has to be said here.

      But it is not an alarm, and it must not be painted as one. Messages keep
      arriving through every other relay in the union; what is at risk is only
      what a particular relay is holding. So: one collapsed line for the whole
      condition, neutral, with the fix stated ONCE behind a disclosure instead of
      a red block repeated per (account, relay) pair. It used to render four
      identical five-line red panels and own the entire screen.

      We only know the signature did not come back, not why, so the copy names the
      likeliest cause without asserting it. Wording checked against Amber's own
      strings.xml: the setting is "Client auth whitelist", it takes hostnames, and
      there is no wildcard — the `*` belongs to a different prompt. %>
  <% blocked = @accounts.select { |a| a.settings&.dig("amber_auth_blocked_at").present? } %>
  <% if blocked.any? %>
    <% hosts = blocked.filter_map { |a| a.settings["amber_auth_blocked_relay"] }.uniq %>
    <details class="border rule">
      <summary class="flex cursor-pointer list-none items-center gap-2.5 px-3 py-2.5">
        <span class="lamp" aria-hidden="true"></span>
        <span class="eng"><%= pluralize(blocked.size, "account") %> not relay-authenticated</span>
        <span class="text-sm text-gray-500 dark:text-gray-400">
          Messages still arrive through your other relays — anything stored only on
          <%= hosts.size == 1 ? "this one" : "these" %> may be missing.
        </span>
      </summary>

      <div class="border-t rule px-3 py-3 text-sm text-gray-600 dark:text-gray-300">
        <ul class="mb-3 space-y-1">
          <% blocked.each do |account| %>
            <li class="flex items-center gap-2">
              <span class="wire" style="--wire-ink: <%= account.ink %>; min-height: 14px"></span>
              <span class="condensed uppercase tracking-wider"><%= account.display_name_or_npub %></span>
              <span class="font-mono text-xs text-gray-500 dark:text-gray-400"><%= account.settings["amber_auth_blocked_relay"] %></span>
            </li>
          <% end %>
        </ul>

        <p class="mb-2">
          These relays hand your messages only to an authenticated client, and your
          signer has not completed that handshake yet.
        </p>
        <ul class="list-disc space-y-1 pl-5">
          <li>
            If Amber prompted you and you missed it, just wait — it retries. When it
            asks, <strong>Authentication scope → All relays</strong> stops it asking again.
          </li>
          <li>
            If it never prompts, check <strong>Settings → Client auth whitelist</strong>
            in Amber. While that list is non-empty, Amber rejects relay-auth requests
            from any host that is not on it, without asking. Either add
            <%= safe_join(hosts.map { |h| tag.code(h) }, ", ") %>
            to the list, or clear the list so Amber asks you instead.
          </li>
        </ul>
      </div>
    </details>
  <% end %>

  <% if @accounts.empty? %>
    <div class="border rule p-8 text-center">
      <p class="text-gray-600 dark:text-gray-400">Pair an account to start receiving private messages.</p>
      <%= link_to "Add an account", new_account_path,
            class: "condensed mt-4 inline-block border border-amber-500 bg-amber-500 px-4 py-2.5 text-[14px] font-semibold uppercase tracking-[0.16em] text-[#1a1714] hover:bg-amber-400" %>
    </div>
  <% else %>
    <%# Known vs Requests. Everything not vouched for by a follow, a sibling
        account's follow, the web of trust, or a reply of ours waits in Requests. %>
    <div class="border-b border-gray-200 dark:border-[color:var(--color-rule-dark)]">
      <nav class="-mb-px flex gap-6">
        <% [["known", "Inbox"], ["requests", "Requests"]].each do |tab, label| %>
          <%= link_to messages_path(tab: tab, accounts: @account_filter),
                class: "condensed flex items-center gap-2 border-b-2 px-1 py-3 text-[14px] font-semibold uppercase tracking-[0.14em] transition-colors #{@tab == tab ? 'border-amber-500 text-gray-900 dark:text-gray-100' : 'border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'}" do %>
            <%= label %>
            <span class="font-mono text-[13px] tabular text-gray-500 dark:text-gray-400">
              <%= @counts[tab] %>
            </span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <% if @accounts.size > 1 %>
      <%= form_with url: messages_path, method: :get, data: { dm_filter_target: "form" },
                    class: "flex flex-wrap items-center gap-2" do %>
        <%= hidden_field_tag :tab, @tab %>
        <span class="eng mr-1">Who</span>
        <%# An empty filter means "every account" — this is a central inbox, so
            showing all of them is the default. Render the pills as selected to
            match, rather than leaving them all looking switched off. %>
        <% showing_all = @account_filter.empty? %>
        <% @accounts.each do |account| %>
          <% active = showing_all || @account_filter.include?(account.id) %>
          <label class="cursor-pointer">
            <%= check_box_tag "accounts[]", account.id, active,
                  id: "dm-account-#{account.id}", class: "peer sr-only",
                  data: { action: "change->dm-filter#apply" } %>
            <span class="condensed inline-flex items-center gap-2 border px-2.5 py-1.5 text-[13px] font-semibold uppercase tracking-[0.14em] transition-colors <%= active ? 'border-gray-900 text-gray-900 dark:border-gray-100 dark:text-gray-100' : 'border-gray-300 text-gray-500 opacity-60 hover:opacity-100 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400' %>">
              <span class="inline-block h-3 w-[3px] flex-none" style="background: <%= account.ink %>"></span>
              <%= account.display_name_or_npub %>
            </span>
          </label>
        <% end %>
        <%# "Select all" clears the filter, which is the same thing — but says so
            in the user's terms rather than ours. Hidden when everything is
            already shown, so it never reads as a no-op.

            The empty `accounts` param is required, not decoration: the filter is
            persisted, so a link without it leaves params[:accounts] absent, the
            controller falls back to the stored subset, and the link does nothing
            at all. %>
        <% unless showing_all %>
          <%= link_to "Select all", messages_path(tab: @tab, accounts: [ "" ]),
                class: "text-sm font-medium text-amber-600 underline hover:text-amber-500 dark:text-amber-400" %>
        <% end %>
        <noscript><%= submit_tag "Filter", class: "rounded bg-gray-200 px-2 py-1 text-sm dark:bg-gray-700" %></noscript>
      <% end %>
    <% end %>

    <div class="flex flex-wrap items-center gap-3">
      <%# Both act on the tab and account filter currently in view, so they never
          quietly touch conversations the user cannot see. %>
      <% if @unread_only %>
        <%= link_to messages_path(tab: @tab, accounts: @account_filter),
              class: "inline-flex items-center gap-1.5 rounded-full border border-amber-500 bg-amber-50 px-3 py-1 text-sm font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300" do %>
          Unread only
          <span aria-hidden="true">&times;</span>
        <% end %>
      <% else %>
        <%= link_to "Filter by unread", messages_path(tab: @tab, accounts: @account_filter, unread: "1"),
              class: "condensed border border-gray-300 px-3 py-1.5 text-[13px] font-semibold uppercase tracking-[0.14em] text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400" %>
      <% end %>

      <%= button_to "Mark all as read",
            mark_all_read_messages_path(tab: @tab, accounts: @account_filter),
            method: :post, form: { data: { turbo_confirm: "Mark every unread conversation in this view as read?" } },
            class: "condensed border border-gray-300 px-3 py-1.5 text-[13px] font-semibold uppercase tracking-[0.14em] text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400" %>
    </div>

    <% syncing = @sync_states.values.select { |s| s.step.present? } %>
    <% if syncing.any? %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-900/30 dark:text-amber-200">
        <% syncing.each { |state| %><p><%= state.step %></p><% } %>
      </div>
    <% end %>

    <div class="border rule overflow-hidden">
      <% if @conversations.any? %>
        <ul class="divide-y divide-gray-200 dark:divide-gray-700">
          <%= render partial: "conversations/conversation_row", collection: @conversations, as: :conversation %>
        </ul>
      <% else %>
        <div class="p-10 text-center">
          <p class="text-gray-600 dark:text-gray-400">
            <%= @tab == "requests" ? "No message requests." : "No messages yet." %>
          </p>
          <% if @tab == "known" %>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">
              Messages from people you follow appear here. Everyone else waits in Requests.
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

    <%= paginate @conversations if respond_to?(:paginate) %>
  <% end %>
</div>
