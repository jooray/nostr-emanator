<%# One forme on the stone.

    The row is deliberately NOT wrapped in a link. It used to be, with
    render_nostr_content emitting its own anchors for resolved mentions inside —
    invalid nested anchors, and clicking a mention navigated to the post instead
    of the mention. The hour is the link; the copy is plain text. %>
<% waiting = local_assigns[:waiting] %>
<% short = local_assigns[:short] %>
<% failed = local_assigns[:failed] %>
<% sent = local_assigns[:sent] %>
<% stamp = sent ? post.published_at : post.scheduled_at %>

<article <%= tag.attributes(data: { controller: "elapsed", elapsed_start_value: post.updated_at.iso8601 }) if waiting %>
         class="grid items-center gap-x-4 gap-y-2 border-b rule py-3.5 grid-cols-[auto_minmax(0,1fr)] sm:grid-cols-[84px_minmax(0,148px)_minmax(0,1fr)_auto]
                <%= 'row-wait' if waiting %>">

  <%# hour %>
  <div class="row-start-1 sm:col-start-1">
    <%= link_to post_path(post), class: "hour block hover:text-amber-600 dark:hover:text-amber-400" do %>
      <%= stamp ? l(stamp, format: "%H:%M") : "--:--" %>
    <% end %>
    <span class="eng mt-1.5 block">
      <% if stamp.nil? %>Draft<% elsif sent %>Sent<% elsif stamp.to_date == Date.current %>Today<% elsif stamp.to_date == Date.tomorrow %>Tomorrow<% else %><%= l(stamp, format: "%d %b") %><% end %>
    </span>
  </div>

  <%# identity %>
  <div class="row-start-1 min-w-0 justify-self-end overflow-hidden sm:col-start-2 sm:w-full sm:justify-self-stretch">
    <%= identity(post.account) %>
  </div>

  <%# copy %>
  <div class="col-span-2 min-w-0 sm:col-span-1 sm:col-start-3">
    <p class="line-clamp-2 max-w-[62ch] break-words text-[14.5px] leading-relaxed text-gray-700 dark:text-gray-300">
      <%= post.content.to_s.strip %>
    </p>
    <% if post.reposts.loaded? && post.reposts.size.positive? %>
      <p class="eng mt-1.5"><%= pluralize(post.reposts.size, "repost") %></p>
    <% end %>
    <% if failed && post.delivery_failures.any? %>
      <p class="mt-1.5 font-mono text-[11px] text-red-600 dark:text-red-400">
        <%= post.delivery_failures.map { |relay, why| "#{relay.sub(%r{\Awss?://}, '')} #{why}" }.first(2).join(" · ") %>
      </p>
    <% elsif failed %>
      <p class="mt-1.5 text-[12px] text-gray-500 dark:text-gray-400">
        Never reached a relay. Nothing was published.
      </p>
    <% end %>
  </div>

  <%# state and the action that belongs to it %>
  <div class="col-span-2 flex min-w-0 flex-wrap items-center justify-end gap-3 sm:col-span-1 sm:col-start-4">
    <% if waiting %>
      <%# The elapsed counter belongs here, not only on the detail page: this row
          is where an operator finds out something is waiting on them at all. %>
      <span class="font-mono text-[13px] font-bold tabular text-amber-600 dark:text-amber-400"
            data-elapsed-target="readout" aria-label="Waiting for approval">00:00</span>
      <%= link_to "Open", post_path(post), class: "slug slug--wait no-underline" %>
    <% elsif short || sent %>
      <%= poll_strip(post) %>
      <% if short %>
        <%= button_to "Rebroadcast", rebroadcast_post_path(post), method: :post,
              class: "slug hover:text-amber-600 dark:hover:text-amber-400",
              form_class: "inline" %>
      <% end %>
    <% elsif failed %>
      <%= button_to "Retry", retry_publish_post_path(post), method: :post,
            class: "slug slug--short", form_class: "inline" %>
    <% else %>
      <%= status_slug(post) %>
    <% end %>
  </div>
</article>
