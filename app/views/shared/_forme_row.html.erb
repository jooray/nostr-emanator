<%# One forme on the stone.

    The row is deliberately NOT wrapped in a link. It used to be, with
    render_nostr_content emitting its own anchors for resolved mentions inside —
    invalid nested anchors, and clicking a mention navigated to the post instead
    of the mention. The hour is the link; the copy is plain text. %>
<% waiting = local_assigns[:waiting] %>
<% short = local_assigns[:short] %>
<% failed = local_assigns[:failed] %>
<% sent = local_assigns[:sent] %>
<% stamp = sent ? post.published_at : post.scheduled_at %>
<%# A repost rides the same row: its own identity and hour, the note's text, and
    the action that belongs to its state. It links to the note, which is the only
    page a repost has. %>
<% is_repost = post.is_a?(Repost) %>
<% target = forme_target(post) %>

<article <%= tag.attributes(data: { controller: "elapsed", elapsed_start_value: post.updated_at.iso8601 }) if waiting %>
         class="grid items-center gap-x-4 gap-y-2 border-b rule py-3.5 grid-cols-[auto_minmax(0,1fr)] sm:grid-cols-[96px_minmax(0,172px)_minmax(0,1fr)_auto]
                <%= 'row-wait' if waiting %>">

  <%# hour %>
  <div class="row-start-1 sm:col-start-1">
    <%= link_to post_path(target), class: "hour block hover:text-amber-600 dark:hover:text-amber-400" do %>
      <%= stamp ? l(stamp, format: :app_time) : "--:--" %>
    <% end %>
    <span class="eng mt-1.5 block">
      <% if stamp.nil? %><%= t(".draft") %><% elsif sent %><%= t(".sent") %><% elsif stamp.to_date == Date.current %><%= t(".today") %><% elsif stamp.to_date == Date.tomorrow %><%= t(".tomorrow") %><% else %><%= l(stamp, format: :app_day_month) %><% end %>
    </span>
  </div>

  <%# identity %>
  <div class="row-start-1 min-w-0 justify-self-end overflow-hidden sm:col-start-2 sm:w-full sm:justify-self-stretch">
    <%= identity(post.account) %>
  </div>

  <%# copy %>
  <div class="col-span-2 min-w-0 sm:col-span-1 sm:col-start-3">
    <p class="line-clamp-2 max-w-[72ch] break-words text-[16.5px] leading-relaxed text-gray-700 dark:text-gray-300">
      <%= post.content.to_s.strip %>
    </p>
    <% if is_repost %>
      <%# Without this the row is indistinguishable from the note itself, and the
          operator cannot tell which of the two never went out. %>
      <p class="eng mt-1.5"><%= t(".repost_of_note") %></p>
    <% elsif post.reposts.loaded? && post.reposts.size.positive? %>
      <p class="eng mt-1.5"><%= t(".reposts", count: post.reposts.size) %></p>
    <% end %>
    <%# "Boost as…" / "Quote as…": only on the post list, which passes the
        accounts it has loaded, and only once the note is out. %>
    <% share_accounts = local_assigns[:share_accounts] %>
    <% if share_accounts && !is_repost && post.published? && post.nostr_reference %>
      <% boosters = Posts::Boost.candidates(post, share_accounts) %>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <% if boosters.any? %>
          <details class="relative" data-controller="dropdown">
            <summary class="slug cursor-pointer list-none select-none hover:text-amber-600 dark:hover:text-amber-400"><%= t(".boost_as") %></summary>
            <div class="absolute left-0 z-20 mt-1.5 max-h-72 min-w-56 overflow-y-auto border rule bg-white py-1 shadow-lg dark:bg-[color:var(--color-panel)]">
              <% boosters.each do |account| %>
                <%= button_to boost_post_path(post), params: { account_id: account.id }, method: :post,
                      class: "flex w-full items-center gap-2 px-3 py-2 text-left text-[14px] text-gray-700 hover:bg-amber-500/10 dark:text-gray-200",
                      form_class: "block" do %>
                  <span class="wire" style="--wire-ink: <%= account.ink %>; min-height: 12px"></span>
                  <span class="truncate"><%= account.display_name_or_npub %></span>
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
        <details class="relative" data-controller="dropdown">
          <summary class="slug cursor-pointer list-none select-none hover:text-amber-600 dark:hover:text-amber-400"><%= t(".quote_as") %></summary>
          <div class="absolute left-0 z-20 mt-1.5 max-h-72 min-w-56 overflow-y-auto border rule bg-white py-1 shadow-lg dark:bg-[color:var(--color-panel)]">
            <% share_accounts.each do |account| %>
              <%= link_to new_account_post_path(account, quote: post.id),
                    class: "flex w-full items-center gap-2 px-3 py-2 text-[14px] text-gray-700 no-underline hover:bg-amber-500/10 dark:text-gray-200" do %>
                <span class="wire" style="--wire-ink: <%= account.ink %>; min-height: 12px"></span>
                <span class="truncate"><%= account.display_name_or_npub %></span>
              <% end %>
            <% end %>
          </div>
        </details>
      </div>
    <% end %>
    <% if failed && (why = delivery_failure_line(post)) %>
      <p class="mt-1.5 font-mono text-[13px] text-red-600 dark:text-red-400"><%= why %></p>
    <% elsif failed %>
      <p class="mt-1.5 text-[14px] text-gray-500 dark:text-gray-400">
        <%= t(".never_reached") %>
      </p>
    <% end %>
  </div>

  <%# state and the action that belongs to it %>
  <div class="col-span-2 flex min-w-0 flex-wrap items-center justify-end gap-3 sm:col-span-1 sm:col-start-4">
    <% if waiting %>
      <%# The elapsed counter belongs here, not only on the detail page: this row
          is where an operator finds out something is waiting on them at all. %>
      <span class="font-mono text-[15px] font-bold tabular text-amber-600 dark:text-amber-400"
            data-elapsed-target="readout" aria-label="<%= t(".waiting_for_approval") %>">00:00</span>
      <%= link_to t(".open"), post_path(target), class: "slug slug--wait no-underline" %>
    <% elsif short || sent %>
      <%= poll_strip(post) %>
      <% if short %>
        <%= button_to t(".rebroadcast"),
              is_repost ? rebroadcast_post_repost_path(post.post, post) : rebroadcast_post_path(post),
              method: :post,
              class: "slug hover:text-amber-600 dark:hover:text-amber-400",
              form_class: "inline" %>
      <% end %>
    <% elsif failed %>
      <%# A failed repost retries through its own signing path: it has its own
          signed event, and retrying the note would not resend it. A note that
          was never signed has nothing to publish, so it is signed first. %>
      <%= button_to t(".retry"),
            if is_repost then retry_sign_post_repost_path(post.post, post)
            elsif post.can_retry_publish? then retry_publish_post_path(post)
            else retry_sign_post_path(post)
            end,
            method: :post,
            class: "slug slug--short", form_class: "inline" %>
    <% else %>
      <%= status_slug(post) %>
    <% end %>
  </div>
</article>
