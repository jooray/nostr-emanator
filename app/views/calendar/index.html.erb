<% content_for :title, "Calendar" %>

<div class="mx-auto max-w-6xl">
  <header class="mb-5 flex flex-wrap items-end justify-between gap-4 border-b rule pb-4">
    <div>
      <h1 class="condensed text-[30px] font-bold uppercase leading-none tracking-[0.06em]">
        <%= @month.strftime("%B %Y") %>
      </h1>
      <p class="eng mt-2.5"><%= pluralize(@posts.size, "post") %> &middot; <%= pluralize(@reposts.size, "repost") %></p>
    </div>

    <div class="flex items-center gap-1">
      <%= link_to calendar_path(month: @month.prev_month.strftime("%Y-%m-%d")), "aria-label": "Previous month",
            class: "border border-gray-300 p-2 text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <%= link_to "Today", calendar_path,
            class: "condensed border border-gray-300 px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400" %>
      <%= link_to calendar_path(month: @month.next_month.strftime("%Y-%m-%d")), "aria-label": "Next month",
            class: "border border-gray-300 p-2 text-gray-600 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-400 dark:hover:text-amber-400" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    </div>
  </header>

  <%# The key. The calendar is the one surface whose whole job is identity over
      time, and it shipped its colour coding with no legend at all — so a colour
      meant nothing unless you already knew what it meant. %>
  <% if @legend.any? %>
    <div class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="eng">Who</span>
      <% @legend.each do |account| %>
        <%= link_to posts_path(account: account.id),
              class: "flex items-center gap-2 no-underline transition-colors hover:text-amber-600 dark:hover:text-amber-400" do %>
          <span class="inline-block h-3 w-3 flex-none" style="background: <%= account.ink %>"></span>
          <span class="condensed text-[11.5px] font-semibold uppercase tracking-[0.13em]"><%= account.display_name_or_npub %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="border rule">
    <div class="grid grid-cols-7 border-b rule">
      <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
        <div class="eng px-2 py-2.5 text-center"><%= day %></div>
      <% end %>
    </div>

    <div class="grid grid-cols-7">
      <% (@start_date..@end_date).each do |date| %>
        <% events = @events_by_date[date] || [] %>
        <% outside = date.month != @month.month %>
        <% today = date == Date.current %>
        <div class="min-h-[118px] border-b border-r rule p-1.5 <%= "opacity-45" if outside %> <%= "bg-amber-500/6" if today %>">
          <div class="mb-1.5 flex items-baseline justify-between">
            <span class="font-mono text-[12px] font-bold tabular <%= today ? "text-amber-600 dark:text-amber-400" : "text-gray-500 dark:text-gray-400" %>">
              <%= date.day %>
            </span>
            <% if today %><span class="eng text-amber-600 dark:text-amber-400">Today</span><% end %>
          </div>

          <% events.first(5).each do |event| %>
            <% item = event[:item] %>
            <% repost = event[:type] == :repost %>
            <%= link_to post_path(repost ? item.post : item),
                  title: "#{item.account.display_name_or_npub} — #{repost ? 'repost' : item.content.to_s.truncate(80)}",
                  class: "mb-1 flex items-start gap-1.5 no-underline transition-opacity hover:opacity-70" do %>
              <span class="mt-[3px] inline-block h-2.5 w-[3px] flex-none" style="background: <%= item.account.ink %>"></span>
              <span class="min-w-0 flex-1 truncate text-[11.5px] leading-tight text-gray-700 dark:text-gray-300">
                <span class="font-mono font-bold tabular"><%= l(item.scheduled_at, format: "%H:%M") %></span>
                <%= repost ? tag.span("repost", class: "eng") : item.content.to_s.truncate(42) %>
              </span>
            <% end %>
          <% end %>

          <% if events.length > 5 %>
            <%# posts#index has no date filter, so this cannot link to the day —
                but it can link to the identity whose day is crowded. %>
            <span class="eng block px-0.5 text-gray-500 dark:text-gray-400">+<%= events.length - 5 %> more</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
