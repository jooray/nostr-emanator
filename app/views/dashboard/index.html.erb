<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Welcome back, <%= current_user.display_name_or_npub %>
    </p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Accounts</dt>
              <dd class="text-lg font-semibold text-gray-900 dark:text-white"><%= @accounts_count %></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-700 px-5 py-3">
        <%= link_to "Manage accounts", accounts_path, class: "text-sm font-medium text-amber-600 dark:text-amber-400 hover:text-amber-500" %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Scheduled</dt>
              <dd class="text-lg font-semibold text-gray-900 dark:text-white"><%= @scheduled_count %></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-700 px-5 py-3">
        <%= link_to "View calendar", calendar_path, class: "text-sm font-medium text-amber-600 dark:text-amber-400 hover:text-amber-500" %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Published</dt>
              <dd class="text-lg font-semibold text-gray-900 dark:text-white"><%= @published_count %></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-700 px-5 py-3">
        <%= link_to "All posts", posts_path, class: "text-sm font-medium text-amber-600 dark:text-amber-400 hover:text-amber-500" %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Total Posts</dt>
              <dd class="text-lg font-semibold text-gray-900 dark:text-white"><%= @posts_count %></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="bg-gray-50 dark:bg-gray-700 px-5 py-3">
        <%= link_to "Create new", new_post_path, class: "text-sm font-medium text-amber-600 dark:text-amber-400 hover:text-amber-500" %>
      </div>
    </div>
  </div>

  <% if @accounts_count == 0 %>
    <div class="bg-amber-50 dark:bg-amber-900/20 rounded-lg p-6">
      <h2 class="text-lg font-medium text-amber-800 dark:text-amber-200">Get Started</h2>
      <p class="mt-2 text-sm text-amber-700 dark:text-amber-300">
        Welcome to Emanator! Pair your Nostr accounts to start scheduling posts.
      </p>
      <ol class="mt-4 space-y-3 text-sm text-amber-700 dark:text-amber-300">
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-200 dark:bg-amber-800 text-amber-800 dark:text-amber-200 font-medium text-xs">1</span>
          <span><strong>Pair Accounts:</strong> Connect your Nostr accounts using NIP-46 (Amber signer).</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-200 dark:bg-amber-800 text-amber-800 dark:text-amber-200 font-medium text-xs">2</span>
          <span><strong>Create Posts:</strong> Write posts with AI assistance, tailored to each account's personality.</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-amber-200 dark:bg-amber-800 text-amber-800 dark:text-amber-200 font-medium text-xs">3</span>
          <span><strong>Schedule & Sign:</strong> Pre-sign events with Amber and schedule them for future publishing.</span>
        </li>
      </ol>
      <div class="mt-6">
        <%= link_to "Pair Account", new_account_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-amber-600 hover:bg-amber-700" %>
      </div>
    </div>
  <% end %>

  <% if @upcoming_posts.any? %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-medium text-gray-900 dark:text-white">Upcoming Posts</h2>
      </div>
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @upcoming_posts.each do |post| %>
          <li class="px-4 py-4 sm:px-6 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
            <%= link_to post_path(post), class: "block" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                      <%= post.account.display_name_or_npub %>
                    </span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      <%= local_time(post.scheduled_at, format: "short") %>
                    </span>
                    <% if post.reposts.any? %>
                      <span class="text-xs text-gray-400">+ <%= post.reposts.count %> reposts</span>
                    <% end %>
                  </div>
                  <p class="text-sm text-gray-900 dark:text-gray-100 line-clamp-2"><%= render_nostr_content(post.content) %></p>
                </div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= post.scheduled? ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' %>">
                  <%= post.status.humanize %>
                </span>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @failed_posts.any? %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden border border-red-200 dark:border-red-800">
      <div class="px-4 py-5 sm:px-6 border-b border-red-200 dark:border-red-800 bg-red-50 dark:bg-red-900/20">
        <h2 class="text-lg font-medium text-red-800 dark:text-red-200">Failed Posts</h2>
      </div>
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @failed_posts.each do |post| %>
          <li class="px-4 py-4 sm:px-6">
            <%= link_to post_path(post), class: "block hover:underline" do %>
              <p class="text-sm text-gray-900 dark:text-gray-100 line-clamp-1"><%= render_nostr_content(post.content.truncate(100)) %></p>
              <p class="text-xs text-gray-500 mt-1"><%= post.account.display_name_or_npub %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
