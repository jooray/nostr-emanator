<% content_for :title, t(".page_title") %>

<%# The stone. Everything here is ordered by what the operator has to act on,
    not by what is easy to count. There are no metric tiles: "Total posts 204"
    answers no question anyone has, and it used to occupy the position now held
    by whatever went wrong overnight. %>

<div class="mx-auto max-w-6xl">
  <header class="mb-7 flex flex-wrap items-end justify-between gap-4 border-b rule pb-4">
    <div>
      <h1 class="condensed text-[38px] font-bold uppercase leading-none tracking-[0.06em]">
        <%= t(".held", count: @held_count) %>
      </h1>
      <p class="eng mt-2.5"><%= t(".on_the_stone_html", count: station_status[:identities]) %></p>
    </div>

    <div class="flex items-center gap-3">
      <% if @unreached.any? %>
        <%= link_to posts_path(status: "short"), class: "alarm no-underline" do %>
          <span class="condensed text-[24px] font-bold leading-none text-red-600 dark:text-red-400 tabular"><%= @unreached.size %></span>
          <span class="condensed text-[13px] uppercase leading-tight tracking-[0.16em] text-red-800 dark:text-red-300">
            <%= t(".barely_reached_html", count: @unreached.size) %>
          </span>
        <% end %>
      <% end %>
      <%= link_to t(".new_post"), new_post_path,
            class: "condensed inline-block border border-amber-500 bg-amber-500 px-4 py-2.5 text-[14px] font-semibold uppercase tracking-[0.16em] text-[#1a1714] transition-colors hover:bg-amber-400" %>
    </div>
  </header>

  <% unless @has_accounts %>
    <div class="border rule px-6 py-10 text-center">
      <p class="eng mb-3"><%= t(".no_identities") %></p>
      <p class="mx-auto mb-5 max-w-md text-gray-600 dark:text-gray-300">
        <%= t(".no_identities_help") %>
      </p>
      <%= link_to t(".pair_account"), new_account_path,
            class: "condensed inline-block border border-amber-500 bg-amber-500 px-4 py-2.5 text-[14px] font-semibold uppercase tracking-[0.16em] text-[#1a1714]" %>
    </div>
  <% end %>

  <%# ---------------------------------------------------------- needs a human %>
  <% if @waiting.any? %>
    <section class="mb-8" aria-labelledby="sec-waiting">
      <h2 id="sec-waiting" class="eng mb-3 flex items-center gap-2.5">
        <%= lamp(:wait) %> <%= t(".waiting_on_you") %>
      </h2>
      <div class="border-t rule">
        <% @waiting.each do |post| %>
          <%= render "shared/forme_row", post: post, waiting: true %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ------------------------------------------------------------ went short %>
  <%# Only what genuinely did not make it onto the network. A note that reached
      five relays of six is a normal publish and says nothing here. %>
  <% if @unreached.any? %>
    <section class="mb-8" aria-labelledby="sec-unreached">
      <h2 id="sec-unreached" class="eng mb-3 flex items-center gap-2.5">
        <%= lamp(:alarm) %> <%= t(".barely_reached_heading") %>
      </h2>
      <p class="mb-3 max-w-prose text-sm text-gray-600 dark:text-gray-300">
        <%= t(".barely_reached_help") %>
      </p>
      <div class="border-t rule">
        <% @unreached.each do |post| %>
          <%= render "shared/forme_row", post: post, short: true %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ---------------------------------------------------------------- failed %>
  <% if @failed.any? %>
    <section class="mb-8" aria-labelledby="sec-failed">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <h2 id="sec-failed" class="eng flex items-center gap-2.5">
          <%= lamp(:alarm) %> <%= @failed_total > @failed.size ? t(".never_went_out_total", count: @failed_total) : t(".never_went_out") %>
        </h2>
        <%# A post scheduled in March is not going to be retried in September.
            Without this the only way to clear a dead backlog was to open each
            one, so the section stayed permanently alarming. %>
        <%= button_to t(".discard_all", count: @failed_total), discard_failed_posts_path, method: :delete,
              class: "slug hover:text-red-600 dark:hover:text-red-400",
              form: { data: { turbo_confirm: t(".discard_confirm", count: @failed_total) } } %>
      </div>
      <div class="border-t rule">
        <% @failed.each do |post| %>
          <%= render "shared/forme_row", post: post, failed: true %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# -------------------------------------------------------------- the queue %>
  <section class="mb-8" aria-labelledby="sec-queue">
    <h2 id="sec-queue" class="eng mb-3"><%= t(".scheduled") %></h2>
    <% if @upcoming.any? %>
      <div class="border-t rule">
        <% @upcoming.each do |post| %>
          <%= render "shared/forme_row", post: post %>
        <% end %>
      </div>
      <%= link_to t(".all_posts"), posts_path, class: "condensed mt-3 inline-block text-[14px] font-semibold uppercase tracking-[0.16em] text-amber-600 underline underline-offset-4 hover:text-amber-500 dark:text-amber-400" %>
    <% elsif @has_accounts %>
      <div class="border rule px-6 py-8 text-center">
        <p class="text-gray-600 dark:text-gray-300"><%= t(".nothing_scheduled") %></p>
        <%= link_to t(".write_one"), new_post_path, class: "eng mt-3 inline-block text-amber-600 hover:text-amber-500 dark:text-amber-400" %>
      </div>
    <% end %>
  </section>

  <%# ---------------------------------------------------------------- recent %>
  <% if @recent.any? %>
    <section aria-labelledby="sec-recent">
      <h2 id="sec-recent" class="eng mb-3"><%= t(".last_pulled") %></h2>
      <div class="border-t rule">
        <% @recent.each do |post| %>
          <%= render "shared/forme_row", post: post, sent: true %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
