<%# Shown only on Android (the controller checks the user agent) until
    dismissed; the dismissal is remembered per browser. Hidden by default so
    desktop and iOS never see it flash. %>
<div class="mb-5 flex items-center gap-2.5 border rule px-3.5 py-2.5" role="status" hidden
     data-controller="android-app-banner">
  <%= lamp(:on) %>
  <p class="flex-1 text-sm text-gray-700 dark:text-gray-200">
    <%= t(".text") %>
    <%= link_to t(".link"), android_app_path, class: "font-medium text-amber-700 dark:text-amber-400 hover:underline" %>
  </p>
  <button type="button" class="px-2 text-lg leading-none text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100"
          aria-label="<%= t(".dismiss") %>" title="<%= t(".dismiss") %>"
          data-action="android-app-banner#dismiss">&times;</button>
</div>
