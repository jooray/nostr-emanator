<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Emanator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Emanator">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#efebe4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#211f1c" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Apply the theme before first paint. theme_controller.js only runs inside
        _navigation, which renders only when signed in — so without this the
        logged-out pages (the login screen above all) were locked to light
        regardless of the visitor's system preference. Doing it here also kills
        the flash of the wrong theme on every other page. %>
    <%= javascript_tag nonce: true do %>
      (function() {
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark" && t !== "system") { t = "system"; }
          var dark = t === "dark" ||
            (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) { /* private mode / no storage */ }
      })();
    <% end %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="manifest" href="/manifest">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "easymde", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flatpickr", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= javascript_tag nonce: true do %>
      if ("serviceWorker" in navigator) {
        // Auto-refresh to a new release: when an updated worker activates and
        // takes control, reload once so the user never has to hard-refresh.
        // Guard against reloading on the very first install (no prior controller)
        // and against reload loops.
        const hadController = !!navigator.serviceWorker.controller
        let reloading = false
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (reloading || !hadController) return
          reloading = true
          window.location.reload()
        })
        navigator.serviceWorker.register("/service-worker.js")
      }
    <% end %>
  </head>

  <body class="h-full" data-controller="local-time"
          data-local-time-zone-value="<%= current_user&.timezone %>">
    <%# A keyboard user should not tab seven rail links and a sign-out before
        reaching the work. The landing page has always had one of these. %>
    <% if user_signed_in? %>
      <a href="#main" class="skip-link">Skip to content</a>
      <%= render "layouts/navigation" %>
    <% end %>

    <main id="main" class="<%= user_signed_in? ? 'lg:pl-60 pt-14 lg:pt-0' : '' %>">
      <div class="<%= user_signed_in? ? 'px-4 py-7 sm:px-6 lg:px-8' : '' %>">
        <%# Flashes announce themselves. They used to be plain divs that a screen
            reader never saw, and the alert variant deleted itself after 9s —
            destroying the only record of a failure the user may not have read. %>
        <% if flash[:notice] %>
          <div class="mb-5 flex items-center gap-2.5 border rule px-3.5 py-2.5" role="status" data-controller="flash">
            <%= lamp(:on) %>
            <p class="text-sm text-gray-700 dark:text-gray-200"><%= flash[:notice] %></p>
          </div>
        <% end %>

        <% if flash[:alert] %>
          <div class="alarm mb-5" role="alert">
            <%= lamp(:alarm) %>
            <p class="text-sm text-red-800 dark:text-red-200"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <%# Async state — signing, publishing, uploading — is written into here by
            the controllers that used to mutate textContent in a silent span. %>
        <div id="console-announcer" class="sr-only" role="status" aria-live="polite"></div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
