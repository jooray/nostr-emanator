<%= form_with(model: post.persisted? ? post : [@account, post], class: "space-y-6") do |form| %>
  <% if post.errors.any? %>
    <div class="rounded-md bg-red-50 dark:bg-red-900/20 p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
            <%= t(".errors_prevented", count: post.errors.count) %>
          </h3>
          <ul class="mt-2 text-sm text-red-700 dark:text-red-300 list-disc list-inside">
            <% post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <% if post.is_reply? && (defined?(reply_context) && reply_context.present? || @reply_context.present?) %>
    <div class="rounded-lg border border-gray-200 dark:border-[color:var(--color-rule-dark)] bg-gray-50 dark:bg-gray-900 p-4">
      <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-1"><%= t(".replying_to") %></p>
      <p class="text-sm text-gray-700 dark:text-gray-300 line-clamp-3"><%= reply_context.presence || @reply_context %></p>
    </div>
  <% end %>

  <div data-controller="media-preview blossom-upload"
       data-blossom-upload-upload-url-value="<%= account_blossom_uploads_path(@account) %>"
       data-blossom-upload-media-value="<%= MediaPreferences.for(current_user).to_json %>"
       data-blossom-upload-video-compress-url-value="<%= asset_path("video_compress.js") %>"
       data-blossom-upload-max-bytes-value="<%= BlossomUpload::MAX_BYTES %>">
    <div class="flex items-center justify-between mb-2">
      <label for="post_content" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
        <%= t(".content") %>
      </label>
      <div class="flex items-center gap-3">
        <button type="button"
          data-action="blossom-upload#openPicker"
          class="inline-flex items-center gap-1 text-xs font-medium text-amber-600 hover:text-amber-700 cursor-pointer">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
          </svg>
          <%= t(".attach") %>
        </button>
      </div>
    </div>
    <div class="relative" data-controller="mention" data-mention-url-value="<%= mentions_path %>">
    <%= form.text_area :content,
      rows: 8,
      class: "w-full rounded-lg border border-gray-200 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 px-4 py-3 text-sm placeholder-gray-400 dark:placeholder-gray-500 resize-y",
      placeholder: post.is_reply? ? t(".reply_placeholder") : t(".content_placeholder"),
      data: {
        media_preview_target: "content",
        content_builder_target: "textarea",
        blossom_upload_target: "textarea",
        mention_target: "textarea",
        action: "input->media-preview#updatePreview input->mention#input keydown->mention#keydown blur->mention#blur dragover->blossom-upload#dragover dragleave->blossom-upload#dragleave drop->blossom-upload#drop paste->blossom-upload#paste"
      } %>
    </div>

    <%# One row per attachment while it uploads: step, progress bar, size note. %>
    <ul data-blossom-upload-target="list" hidden aria-live="polite"
        class="mt-2 divide-y divide-gray-200 dark:divide-[color:var(--color-rule-dark)]"></ul>

    <%= file_field_tag :file, multiple: true, class: "hidden",
      data: { blossom_upload_target: "input", action: "change->blossom-upload#picked" } %>

    <%# Asked before a video that could go up unconverted is re-encoded. Buttons, not a
        method="dialog" form: this already sits inside the post's form. %>
    <dialog data-blossom-upload-target="videoChoice"
            aria-labelledby="video-choice-title"
            class="m-auto w-[min(32rem,calc(100vw-2rem))] border rule bg-white dark:bg-gray-900 p-6 text-gray-900 dark:text-gray-100 backdrop:bg-black/50">
      <h2 id="video-choice-title" class="text-base font-medium"><%= t(".video_choice.title") %></h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300 break-words" data-blossom-upload-target="videoChoiceNames"></p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t(".video_choice.help") %></p>
      <div class="mt-5 flex flex-col gap-2">
        <% { "smaller" => true, "reencode" => false, "original" => false }.each do |mode, primary| %>
          <button type="button" <%= "autofocus" if primary %>
                  data-action="blossom-upload#chooseVideoMode"
                  data-blossom-upload-mode-param="<%= mode %>"
                  class="w-full px-4 py-2 text-left text-sm rounded-lg border transition-colors cursor-pointer <%= primary ? "border-amber-600 bg-amber-600 text-white hover:bg-amber-700" : "border-gray-300 dark:border-[color:var(--color-rule-dark)] hover:bg-gray-50 dark:hover:bg-gray-800" %>">
            <span class="block font-medium"><%= t(".video_choice.#{mode}") %></span>
            <span class="block text-xs <%= primary ? "text-amber-50" : "text-gray-500 dark:text-gray-400" %>"><%= t(".video_choice.#{mode}_help") %></span>
          </button>
        <% end %>
        <button type="button" data-action="blossom-upload#chooseVideoMode" data-blossom-upload-mode-param=""
                class="mt-1 self-end px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 cursor-pointer">
          <%= t(".video_choice.cancel") %>
        </button>
      </div>
    </dialog>

    <!-- Media Preview -->
    <div data-media-preview-target="preview"></div>
  </div>

  <%= form.hidden_field :event_kind, value: post.event_kind || 1 %>

  <% if post.is_reply? %>
    <%= form.hidden_field :reply_to_event_id %>
    <%= form.hidden_field :reply_to_pubkey %>
    <%= form.hidden_field :root_event_id %>
    <%= form.hidden_field :is_reply, value: true %>
  <% end %>

  <div class="flex items-center justify-end gap-3">
    <%= link_to t(".cancel"),
      post.persisted? ? (post.can_schedule? ? schedule_post_path(post) : post_path(post)) : account_posts_path(post.account),
      class: "px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-[color:var(--color-rule-dark)] rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" %>
    <% if post.is_reply? %>
      <%= form.submit t(".sign_publish_reply"),
        class: "px-4 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors cursor-pointer" %>
    <% else %>
      <%= form.submit t(".save_schedule"),
        class: "px-4 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors cursor-pointer" %>
    <% end %>
  </div>
<% end %>
