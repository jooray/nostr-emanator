<%
  status_colors = {
    "published"          => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
    "scheduled"          => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
    "draft"              => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200",
    "awaiting_signature" => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-200",
    "publishing"         => "bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200",
    "failed"             => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200"
  }
  badge_class = status_colors[@post.status] || "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200"
%>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <%= link_to posts_path, class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Post Details</h1>
      </div>
      <div class="flex items-center gap-3 mt-2">
        <div id="post-status-badge">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
            <%= status_label(@post.status) %>
          </span>
        </div>
        <span class="text-sm text-gray-500 dark:text-gray-400">
          Created <%= time_ago_in_words(@post.created_at) %> ago
        </span>
      </div>
    </div>
  </div>

  <!-- Account Info -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-4">
    <div class="flex items-center gap-3">
      <% if @post.account.picture_url.present? %>
        <img src="<%= @post.account.picture_url %>" alt="<%= @post.account.display_name_or_npub %>" class="h-10 w-10 rounded-full object-cover flex-shrink-0">
      <% else %>
        <div class="h-10 w-10 rounded-full bg-amber-100 dark:bg-amber-900 flex items-center justify-center flex-shrink-0">
          <span class="text-amber-600 dark:text-amber-400 font-medium text-sm">
            <%= @post.account.display_name_or_npub[0].upcase %>
          </span>
        </div>
      <% end %>
      <div>
        <p class="text-sm font-medium text-gray-900 dark:text-white">
          <%= @post.account.display_name_or_npub %>
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          <%= @post.account.npub&.truncate(30) %>
        </p>
      </div>
      <div class="ml-auto">
        <span class="text-xs text-gray-400 dark:text-gray-500">Kind <%= @post.event_kind %></span>
      </div>
    </div>
  </div>

  <!-- Content Card -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-6" data-controller="media-preview">
    <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3">Content</h2>
    <div class="prose dark:prose-invert max-w-none">
      <p class="text-gray-900 dark:text-gray-100 whitespace-pre-wrap"><%= render_nostr_content(@post.content) %></p>
    </div>

    <!-- Hidden textarea to drive media preview -->
    <textarea class="hidden" data-media-preview-target="content"><%= @post.content %></textarea>

    <!-- Media Preview -->
    <div data-media-preview-target="preview" class="mt-4"></div>
  </div>

  <!-- Scheduling Info -->
  <% if @post.scheduled_at.present? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-4">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-white">
            Scheduled for <%= local_time(@post.scheduled_at) %>
          </p>
          <% if @post.scheduled_at > Time.current %>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              in <%= time_ago_in_words(@post.scheduled_at) %>
            </p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Event Details -->
  <% if @post.event_id.present? || @post.signed_event.present? || @post.unsigned_event.present? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 overflow-hidden">
      <div class="px-6 py-4">
        <% if @post.event_id.present? %>
          <%
            relay_hints = @post.publish_results.present? ? @post.publish_results.select { |_, v| v == "ok" }.keys.first(3) : []
            nevent = Nostr::KeyConverter.hex_to_nevent(@post.event_id, relays: relay_hints, author_pubkey: @post.account.pubkey_hex)
          %>
          <div class="mb-3">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Event:</span>
              <a href="<%= nevent_url(nevent) %>" target="_blank" rel="noopener noreferrer"
                 class="text-xs text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 underline underline-offset-2 transition-colors">
                View on <%= current_user.event_viewer.capitalize %>
                <svg class="inline h-3 w-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
            <details class="group">
              <summary class="cursor-pointer text-xs text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors select-none list-none flex items-center gap-1">
                <svg class="h-3 w-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>Show event ID</span>
              </summary>
              <code class="mt-1 block text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-900 px-2 py-1 rounded select-all break-all"><%= @post.event_id %></code>
            </details>
          </div>
        <% end %>

        <details class="group">
          <summary class="cursor-pointer text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 transition-colors select-none list-none flex items-center gap-1">
            <svg class="h-4 w-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="group-open:hidden">Show event JSON</span>
            <span class="hidden group-open:inline">Hide event JSON</span>
          </summary>
          <div class="mt-4">
            <% event_to_show = @post.signed_event || @post.unsigned_event %>
            <% label = @post.signed_event.present? ? "Signed Event" : "Unsigned Event" %>
            <h3 class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2"><%= label %></h3>
            <pre class="text-xs text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900 rounded-lg p-4 overflow-x-auto"><%= JSON.pretty_generate(event_to_show) %></pre>
          </div>
        </details>
      </div>
    </div>
  <% end %>

  <!-- Signing Progress -->
  <% if @post.awaiting_signature? || (@post.failed? && @post.signed_event.blank? && @post.unsigned_event.present?) %>
    <%= turbo_stream_from "post_signing_#{@post.id}" %>
    <%= render "posts/signing_progress", post: @post %>
  <% end %>

  <!-- Publish Progress -->
  <%# Subscribe + render the container unconditionally: a post that's still
      awaiting_signature can flip to scheduled/publishing/published while this
      page stays open, and PublishPostJob's broadcast_replace_to targets
      #publish-progress by id — it has to already exist client-side (and this
      page has to be subscribed to the stream) for that update to land. %>
  <%= turbo_stream_from "post_publishing_#{@post.id}" %>
  <% if @post.scheduled? && @post.signed_event.present? %>
    <%= render "posts/signing_progress", post: @post %>
  <% end %>
  <%= render "posts/publish_progress", post: @post %>

  <!-- Reposts -->
  <%= render "posts/reposts_list", post: @post %>

  <!-- Action Buttons -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-gray-200 dark:border-gray-700 p-6">
    <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-4">Actions</h2>
    <div class="flex flex-wrap gap-3">
      <% if @post.draft? %>
        <%= link_to edit_post_path(@post),
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Edit
        <% end %>
      <% end %>

      <% if @post.can_schedule? %>
        <%= link_to schedule_post_path(@post),
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Schedule
        <% end %>
      <% end %>

      <% if @post.can_publish? %>
        <%= button_to publish_now_post_path(@post),
          method: :post,
          data: { turbo_confirm: "Publish this post to relays right now?" },
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-green-600 hover:bg-green-700 rounded-lg shadow-sm transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"/>
          </svg>
          Publish Now
        <% end %>
      <% end %>

      <% if @post.can_reschedule? %>
        <%= button_to reschedule_post_path(@post),
          method: :post,
          data: { turbo_confirm: "Reschedule this post? It will return to draft for re-signing." },
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-amber-700 dark:text-amber-300 bg-white dark:bg-gray-700 border border-amber-300 dark:border-amber-700 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Reschedule
        <% end %>
      <% end %>

      <% if @post.can_cancel? %>
        <%= button_to cancel_post_path(@post),
          method: :post,
          data: { turbo_confirm: "Cancel this post? All reposts will be removed and the post will return to draft." },
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-700 border border-red-300 dark:border-red-700 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Cancel Schedule
        <% end %>
      <% end %>

      <% if @post.draft? %>
        <%= button_to post_path(@post),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this post?" },
          class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-red-600 dark:text-red-400 bg-white dark:bg-gray-700 border border-red-300 dark:border-red-700 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>
</div>
