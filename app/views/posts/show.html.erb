<div class="mx-auto max-w-3xl space-y-5">
  <header class="border-b rule pb-4">
    <div class="flex items-center gap-3">
      <%= link_to posts_path, "aria-label": "Back to all posts",
            class: "text-gray-500 hover:text-gray-900 dark:hover:text-gray-200" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <h1 class="condensed text-[31px] font-bold uppercase leading-none tracking-[0.06em]">The forme</h1>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
      <div id="post-status-badge">
        <%= status_slug(@post) || tag.span("Pulled #{@post.delivery_tally}", class: "slug") %>
      </div>
      <%= identity(@post.account) %>
      <span class="eng ml-auto">Kind <%= @post.event_kind %> &middot; set <%= time_ago_in_words(@post.created_at) %> ago</span>
    </div>
  </header>

  <%# The note itself, set at reading scale. It used to be a panel headed
      "Content", weighted identically to a panel headed "Actions". %>
  <div data-controller="media-preview">
    <p class="max-w-[68ch] whitespace-pre-wrap break-words text-[18px] leading-relaxed text-gray-900 dark:text-gray-100"><%= render_nostr_content(@post.content.to_s.strip) %></p>

    <!-- Hidden textarea to drive media preview -->
    <textarea class="hidden" data-media-preview-target="content"><%= @post.content %></textarea>

    <!-- Media Preview -->
    <div data-media-preview-target="preview" class="mt-4"></div>
  </div>

  <% if @post.scheduled_at.present? %>
    <div class="border rule p-4">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="eng">Due</span>
        <span class="font-mono text-[17px] font-bold tabular"><%= local_time(@post.scheduled_at) %></span>
        <% if @post.scheduled_at > Time.current %>
          <span class="eng">in <%= time_ago_in_words(@post.scheduled_at) %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Event Details -->
  <% if @post.event_id.present? || @post.signed_event.present? || @post.unsigned_event.present? %>
    <div class="border rule overflow-hidden">
      <div class="px-6 py-4">
        <% if @post.event_id.present? %>
          <%
            relay_hints = @post.publish_results.present? ? @post.publish_results.select { |_, v| v == "ok" }.keys.first(3) : []
            nevent = Nostr::KeyConverter.hex_to_nevent(@post.event_id, relays: relay_hints, author_pubkey: @post.account.pubkey_hex)
          %>
          <div class="mb-3">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Event:</span>
              <a href="<%= nevent_url(nevent) %>" target="_blank" rel="noopener noreferrer"
                 class="text-xs text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 underline underline-offset-2 transition-colors">
                View on <%= current_user.event_viewer.capitalize %>
                <svg class="inline h-3 w-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            </div>
            <details class="group">
              <summary class="cursor-pointer text-xs text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors select-none list-none flex items-center gap-1">
                <svg class="h-3 w-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                <span>Show event ID</span>
              </summary>
              <code class="mt-1 block text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-900 px-2 py-1 rounded select-all break-all"><%= @post.event_id %></code>
            </details>
          </div>
        <% end %>

        <details class="group">
          <summary class="eng flex cursor-pointer list-none select-none items-center gap-1.5 transition-colors hover:text-amber-600 dark:hover:text-amber-400">
            <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
            <span class="group-open:hidden">The signed event</span>
            <span class="hidden group-open:inline">Hide the signed event</span>
          </summary>
          <div class="mt-4">
            <% event_to_show = @post.signed_event || @post.unsigned_event %>
            <% label = @post.signed_event.present? ? "Signed Event" : "Unsigned Event" %>
            <h3 class="eng mb-2"><%= label %></h3>
            <pre class="text-xs text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-900 p-4 overflow-x-auto"><%= JSON.pretty_generate(event_to_show) %></pre>
          </div>
        </details>
      </div>
    </div>
  <% end %>

  <!-- Signing Progress -->
  <% if @post.awaiting_signature? || (@post.failed? && @post.signed_event.blank? && @post.unsigned_event.present?) %>
    <%= turbo_stream_from "post_signing_#{@post.id}" %>
    <%= render "posts/signing_progress", post: @post %>
  <% end %>

  <!-- Publish Progress -->
  <%# Subscribe + render the container unconditionally: a post that's still
      awaiting_signature can flip to scheduled/publishing/published while this
      page stays open, and PublishPostJob's broadcast_replace_to targets
      #publish-progress by id — it has to already exist client-side (and this
      page has to be subscribed to the stream) for that update to land. %>
  <%= turbo_stream_from "post_publishing_#{@post.id}" %>
  <% if @post.scheduled? && @post.signed_event.present? %>
    <%= render "posts/signing_progress", post: @post %>
  <% end %>
  <%= render "posts/publish_progress", post: @post %>

  <!-- Reposts -->
  <%= render "posts/reposts_list", post: @post %>

  <!-- Action Buttons -->
  <%# Rendered only when something is actually actionable. Every button here is
      conditional, so in some states this slab rendered empty — a heading reading
      "Actions" carrying the same visual weight as the post's own content. %>
  <% actions = capture do %>
      <% if @post.draft? %>
        <%= link_to edit_post_path(@post),
          class: "condensed inline-flex items-center gap-2 border border-gray-400 px-3.5 py-2 text-[14px] font-semibold uppercase tracking-[0.16em] text-gray-700 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-200 dark:hover:text-amber-400" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Edit
        <% end %>
      <% end %>

      <% if @post.can_schedule? %>
        <%= link_to schedule_post_path(@post),
          class: "condensed inline-flex items-center gap-2 border border-amber-500 bg-amber-500 px-3.5 py-2 text-[14px] font-semibold uppercase tracking-[0.16em] text-[#1a1714] transition-colors hover:bg-amber-400" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Schedule
        <% end %>
      <% end %>

      <% if @post.can_reschedule? %>
        <%= button_to reschedule_post_path(@post),
          method: :post,
          data: { turbo_confirm: "Reschedule this post? It will return to draft for re-signing." },
          class: "condensed inline-flex items-center gap-2 border border-amber-500 px-3.5 py-2 text-[14px] font-semibold uppercase tracking-[0.16em] text-amber-600 transition-colors hover:bg-amber-500/10 dark:text-amber-400" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Reschedule
        <% end %>
      <% end %>

      <% if @post.can_cancel? %>
        <%= button_to cancel_post_path(@post),
          method: :post,
          data: { turbo_confirm: "Cancel this post? All reposts will be removed and the post will return to draft." },
          class: "condensed inline-flex items-center gap-2 border border-red-500 px-3.5 py-2 text-[14px] font-semibold uppercase tracking-[0.16em] text-red-600 transition-colors hover:bg-red-500/10 dark:text-red-400" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
          Cancel Schedule
        <% end %>
      <% end %>

      <% if @post.draft? %>
        <%= button_to post_path(@post),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete this post?" },
          class: "condensed inline-flex items-center gap-2 border border-red-500 px-3.5 py-2 text-[14px] font-semibold uppercase tracking-[0.16em] text-red-600 transition-colors hover:bg-red-500/10 dark:text-red-400" do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          Delete
        <% end %>
      <% end %>
  <% end %>

  <% if actions.to_s.strip.present? %>
    <div class="border rule p-5">
      <h2 class="eng mb-3">Actions</h2>
      <div class="flex flex-wrap gap-3"><%= actions %></div>
    </div>
  <% end %>
</div>
