<div id="publish-progress">
  <% if post.published? %>
    <!-- Published successfully -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-green-200 dark:border-green-800 p-6">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-white">Published</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              <% if post.published_at.present? %>
                <%= local_time(post.published_at) %>
              <% end %>
            </p>
          </div>
        </div>
        <% if post.can_rebroadcast? %>
          <%= button_to rebroadcast_post_path(post),
            method: :post,
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-amber-700 dark:text-amber-300 bg-white dark:bg-gray-700 border border-amber-300 dark:border-amber-700 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
            Rebroadcast
          <% end %>
        <% end %>
      </div>

      <% if post.publish_results.present? %>
        <% ok = post.publish_results.values.count { |v| v == "ok" } %>
        <% total = post.publish_results.size %>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-2"><%= ok %>/<%= total %> relays succeeded</p>
        <div class="space-y-1">
          <% post.publish_results.each do |relay, result| %>
            <div class="flex items-center gap-2 text-xs">
              <span class="<%= result == 'ok' ? 'text-green-500' : 'text-red-500' %>">&#9679;</span>
              <span class="text-gray-600 dark:text-gray-400 truncate flex-1"><%= relay %></span>
              <span class="text-gray-400"><%= result %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  <% elsif post.failed? %>
    <!-- Publishing failed -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-red-200 dark:border-red-800 p-6">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-white">Publishing failed</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">All relays rejected or timed out.</p>
          </div>
        </div>
        <% if post.can_retry_publish? %>
          <%= button_to retry_publish_post_path(post),
            method: :post,
            class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Retry Publish
          <% end %>
        <% end %>
      </div>

      <% if post.publish_results.present? %>
        <div class="space-y-1">
          <% post.publish_results.each do |relay, result| %>
            <div class="flex items-center gap-2 text-xs">
              <span class="<%= result == 'ok' ? 'text-green-500' : 'text-red-500' %>">&#9679;</span>
              <span class="text-gray-600 dark:text-gray-400 truncate flex-1"><%= relay %></span>
              <span class="text-gray-400"><%= result %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  <% elsif post.publishing? %>
    <!-- Currently publishing -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-indigo-200 dark:border-indigo-800 p-6">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-indigo-500 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-white">Publishing to relays...</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">Sending your post to Nostr relays.</p>
        </div>
      </div>
    </div>

  <% elsif post.scheduled? %>
    <% if post.scheduled_at.present? && post.scheduled_at > Time.current %>
      <!-- Scheduled, time in future — handled by scheduling info card -->
    <% elsif post.scheduled_at.present? && post.scheduled_at <= Time.current %>
      <!-- Scheduled, time has passed — waiting for pickup -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow border border-yellow-200 dark:border-yellow-800 p-6">
        <div class="flex items-center gap-3">
          <svg class="h-5 w-5 text-yellow-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-white">Publishing soon...</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Scheduled time has passed. Will be picked up within a minute.</p>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
