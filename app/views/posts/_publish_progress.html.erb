<%# The press run: one impression per relay.

    This is the partial that used to lie. One relay out of six accepting set the
    record to `published`, and this card rendered a green border, a green check
    and the word "Published", with "1/6 relays succeeded" beneath it in 12px
    gray at 2.85:1 contrast. A note that reached one relay and a note that
    reached six were the same event on screen.

    Delivery is now graded from publish_results (RelayDelivery), never from
    status: `all` is quiet, `partial` and `none` are the alarm. The failing
    relays are listed first, because they are the reason anyone reads this. %>
<div id="publish-progress">
  <% if post.published? %>
    <% short = post.delivery_alarming? %>
    <div class="<%= short ? "alarm is-stacked" : "border rule px-4 py-3.5" %>" <%= 'role=alert'.html_safe if short %>>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <%= lamp(short ? :alarm : :on) %>
          <p class="eng <%= "text-red-700 dark:text-red-300" if short %>">
            <% if short %>
              Reached <%= post.delivery_ok_count %> of <%= post.delivery_total %> relays
            <% else %>
              <% if post.delivery_grade == :all %>
                Pulled &middot; all <%= post.delivery_total %> relays
              <% else %>
                Pulled &middot; <%= post.delivery_tally %> relays
              <% end %>
            <% end %>
          </p>
          <% if post.published_at.present? %>
            <span class="text-[12px] text-gray-500 dark:text-gray-400"><%= local_time(post.published_at) %></span>
          <% end %>
        </div>
        <% if post.can_rebroadcast? %>
          <%= button_to "Rebroadcast", rebroadcast_post_path(post), method: :post,
                class: "slug #{'slug--short' if short} hover:text-amber-600 dark:hover:text-amber-400",
                form_class: "inline" %>
        <% end %>
      </div>

      <% if short %>
        <p class="mt-2 max-w-prose text-sm text-red-800 dark:text-red-200">
          The event is live on the relays that accepted it, but anyone reading only
          <%= post.delivery_failures.keys.map { |r| r.sub(%r{\Awss?://}, "") }.to_sentence %>
          will not see it. Rebroadcast sends the same signed event again — it is not re-signed.
        </p>
      <% end %>

      <% if post.delivery_total.positive? %>
        <ul class="mt-3 border-t rule pt-2.5 space-y-1.5">
          <%# Failures first: the list exists for them. %>
          <% post.delivery_failures.each do |relay, result| %>
            <li class="flex items-baseline gap-2.5 text-[13px]">
              <%= lamp(:alarm) %>
              <span class="min-w-0 flex-1 truncate font-mono text-gray-700 dark:text-gray-200"><%= relay %></span>
              <span class="max-w-[38ch] truncate text-red-700 dark:text-red-400" title="<%= result %>"><%= result %></span>
            </li>
          <% end %>
          <% post.delivery_results.select { |_r, v| v.to_s == "ok" }.each_key do |relay| %>
            <li class="flex items-baseline gap-2.5 text-[13px]">
              <%= lamp(:on) %>
              <span class="min-w-0 flex-1 truncate font-mono text-gray-600 dark:text-gray-300"><%= relay %></span>
              <span class="eng">Accepted</span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

  <% elsif post.failed? %>
    <div class="alarm is-stacked" role="alert">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <%= lamp(:alarm) %>
          <p class="eng text-red-700 dark:text-red-300">Never went out</p>
        </div>
        <% if post.can_retry_publish? %>
          <%= button_to "Try again", retry_publish_post_path(post), method: :post,
                class: "condensed border border-amber-500 bg-amber-500 px-3.5 py-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#1a1714] hover:bg-amber-400" %>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-red-800 dark:text-red-200">
        <%# The old copy asserted "All relays rejected or timed out" while
            rendering a per-relay list that could say otherwise. %>
        <% if post.delivery_total.positive? %>
          None of the <%= post.delivery_total %> relays accepted it. Nothing was published.
        <% else %>
          It never reached a relay. Nothing was published.
        <% end %>
      </p>
      <% if post.delivery_total.positive? %>
        <ul class="mt-3 border-t rule pt-2.5 space-y-1.5">
          <% post.delivery_results.each do |relay, result| %>
            <li class="flex items-baseline gap-2.5 text-[13px]">
              <%= lamp(:alarm) %>
              <span class="min-w-0 flex-1 truncate font-mono text-gray-700 dark:text-gray-200"><%= relay %></span>
              <span class="max-w-[38ch] truncate text-red-700 dark:text-red-400" title="<%= result %>"><%= result %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

  <% elsif post.publishing? %>
    <div class="border rule px-4 py-3.5" role="status" aria-live="polite">
      <div class="flex items-center gap-2.5">
        <%= lamp(:wait) %>
        <p class="eng">Running the press</p>
      </div>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
        Sending the signed event to <%= post.account.display_name_or_npub %>'s relays.
        Each one is asked in turn; results appear here as they answer.
      </p>

      <%# C4: publishing used to be a dead end — if the job died the spinner span
          forever. It is swept after 15 minutes, but offer a way out before that. %>
      <% if post.updated_at < Post::STALE_PUBLISHING_AFTER.ago %>
        <div class="mt-3.5 border-t rule pt-3">
          <p class="mb-2.5 max-w-prose text-sm text-gray-600 dark:text-gray-300">
            This has been running for a while, so the publish job may have died.
            The event may already be live on relays — check before retrying.
          </p>
          <%= button_to "Retry publishing", retry_publish_post_path(post), method: :post,
                class: "condensed border border-amber-500 bg-amber-500 px-3.5 py-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-[#1a1714] hover:bg-amber-400",
                form: { data: { turbo_confirm: "Retry publishing? If the event already reached relays this is a no-op." } } %>
        </div>
      <% end %>
    </div>

  <% elsif post.scheduled? && post.scheduled_at.present? && post.scheduled_at <= Time.current %>
    <div class="border rule px-4 py-3.5" role="status">
      <div class="flex items-center gap-2.5">
        <%= lamp(:wait) %>
        <p class="eng">Due now</p>
      </div>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
        Its scheduled time has passed. The scheduler picks it up within a minute.
      </p>
    </div>
  <% end %>
</div>
