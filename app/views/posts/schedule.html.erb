<div class="max-w-3xl mx-auto space-y-6" data-controller="post-scheduler"
     data-post-scheduler-soon-minutes-value="<%= PostsController::SOON_MINUTES %>"
     data-post-scheduler-suggested-time-value="<%= @suggested_time&.strftime('%Y-%m-%dT%H:%M') %>">
  <!-- Header -->
  <div>
    <div class="flex items-center gap-3 mb-1">
      <%= link_to account_posts_path(@post.account), class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t(".title") %></h1>
    </div>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      <%= t(".subtitle") %>
    </p>
  </div>

  <!-- Post Content Preview -->
  <div class="border rule p-6">
    <h2 class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-3"><%= t(".post_preview") %></h2>
    <div class="flex items-start gap-3">
      <div class="h-8 w-8 flex items-center justify-center flex-shrink-0 flex items-center justify-center border border-gray-400 dark:border-gray-500"><span class="font-medium text-xs condensed font-bold uppercase tracking-wide text-gray-600 dark:text-gray-300"><%= @post.account.display_name_or_npub[0].upcase %></span></div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium text-gray-900 dark:text-white mb-1">
          <%= @post.account.display_name_or_npub %>
        </p>
        <p class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap break-words"><%= render_nostr_content(@post.content) %></p>
      </div>
    </div>

    <%# Saving from the composer lands here directly, so the edit/delete that
        used to live on the post page have to be reachable from the preview.
        Outside the sign form below: a button_to inside it would nest forms. %>
    <div class="mt-4 flex flex-wrap gap-3">
      <%= link_to edit_post_path(@post),
        class: "condensed inline-flex items-center gap-2 border border-gray-400 px-3 py-1.5 text-[13px] font-semibold uppercase tracking-[0.16em] text-gray-700 transition-colors hover:border-amber-500 hover:text-amber-600 dark:border-[color:var(--color-rule-dark)] dark:text-gray-200 dark:hover:text-amber-400" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        <%= t(".edit") %>
      <% end %>
      <% if @post.draft? %>
      <%= button_to post_path(@post),
        method: :delete,
        data: { turbo_confirm: t(".delete_confirm") },
        class: "condensed inline-flex items-center gap-2 border border-red-500 px-3 py-1.5 text-[13px] font-semibold uppercase tracking-[0.16em] text-red-600 transition-colors hover:bg-red-500/10 dark:text-red-400" do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        <%= t(".delete") %>
      <% end %>
      <% end %>
    </div>
  </div>

  <!-- Schedule Form -->
  <%= form_with url: sign_post_path(@post), method: :post, class: "space-y-6" do |form| %>
    <input type="hidden" name="timezone" data-post-scheduler-target="timezoneInput">

    <!-- Date/Time Picker -->
    <div class="border rule p-6">
      <h2 class="text-sm font-medium text-gray-900 dark:text-white mb-4">
        <svg class="h-4 w-4 inline-block mr-1 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <%= t(".schedule_time") %>
      </h2>

      <div class="space-y-4">
        <div>
          <label for="scheduled_at" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
            <%= t(".publish_date_time") %>
          </label>
          <input type="text"
                 id="scheduled_at"
                 name="scheduled_at"
                 required
                 value="<%= params[:scheduled_at] %>"
                 placeholder="<%= t(".select_date_time") %>"
                 class="w-full sm:w-auto rounded-lg border <%= @schedule_error.present? ? 'border-red-400 dark:border-red-500' : 'border-gray-200 dark:border-[color:var(--color-rule-dark)]' %> bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 px-4 py-2 text-sm "
                 data-post-scheduler-target="datetimeInput">
          <% if @schedule_error.present? %>
            <p class="mt-2 text-sm text-red-600 dark:text-red-400"><%= @schedule_error %></p>
          <% end %>
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <%# "Now" can't be the literal now: signing takes a round-trip to the
              phone, and a note backdated to cover that never lands at the top
              of anyone's feed. A few minutes ahead is as close as it gets. %>
          <button type="button"
                  class="px-3 py-1 text-xs font-medium text-amber-700 dark:text-amber-300 border border-amber-600 dark:border-amber-400 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-900/30 transition-colors"
                  data-action="click->post-scheduler#useSoon"
                  title="<%= t(".soon_title", count: PostsController::SOON_MINUTES) %>">
            <%= t(".soon") %>
          </button>
          <% if @suggested_time.present? %>
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-500 dark:text-gray-400"><%= t(".suggested") %></span>
              <button type="button"
                      class="text-xs text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 underline"
                      data-action="click->post-scheduler#useSuggestion"
                      data-time="<%= @suggested_time.strftime('%Y-%m-%dT%H:%M') %>">
                <%= local_time(@suggested_time) %>
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Repost Accounts -->
    <% if @other_accounts.any? %>
      <%# Every ticked box here costs one more Amber approval on the user's
          phone, in sequence. The old screen said none of that: eighteen
          unfiltered rows and a bare "Select All". %>
      <div class="border rule p-5" data-controller="repost-picker">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <h2 class="eng"><%= t(".also_post_as") %></h2>
          <label class="flex cursor-pointer items-center gap-2">
            <input type="checkbox" data-repost-picker-target="selectAll"
                   data-action="change->repost-picker#toggleAll change->post-scheduler#toggleReposts"
                   class="border-gray-300 text-amber-600 dark:border-[color:var(--color-rule-dark)]">
            <span class="eng"><%= t(".select_all_shown") %></span>
          </label>
        </div>

        <p class="mb-3 text-sm font-medium" data-repost-picker-target="readout"
           data-level="quiet" role="status" aria-live="polite"></p>

        <% if @other_accounts.size > 6 %>
          <label class="sr-only" for="repost-filter"><%= t(".filter_identities") %></label>
          <input type="search" id="repost-filter" data-repost-picker-target="filter"
                 data-action="input->repost-picker#filter"
                 placeholder="<%= t(".filter_placeholder") %>"
                 class="mb-3 w-full border border-gray-300 bg-white px-3 py-2 text-sm dark:border-[color:var(--color-rule-dark)] dark:bg-[color:var(--color-chassis)]">
        <% end %>

        <ul class="border-t rule">
          <% @other_accounts.each do |account| %>
            <%
              already_reposting = @existing_reposts&.any? { |r| r.account_id == account.id } ||
                                  @preselected_repost_ids&.include?(account.id)
              search = [account.display_name, account.username, account.npub, account.pubkey_hex].compact.join(" ").downcase
            %>
            <li data-repost-picker-target="row" data-search="<%= search %>">
              <label class="flex cursor-pointer items-center gap-3 border-b rule py-2.5">
                <input type="checkbox" name="repost_account_ids[]" value="<%= account.id %>"
                       data-repost-checkbox data-repost-picker-target="checkbox"
                       data-action="change->repost-picker#report"
                       class="border-gray-300 text-amber-600 dark:border-[color:var(--color-rule-dark)]"
                       <%= "checked" if already_reposting %>>
                <%= identity(account, link: false) %>
                <% if already_reposting %>
                  <span class="slug ml-auto"><%= t(".already_scheduled") %></span>
                <% end %>
              </label>
            </li>
          <% end %>
        </ul>
        <p class="py-3 text-sm text-gray-500 dark:text-gray-400" data-repost-picker-target="empty" hidden>
          <%= t(".no_identity_matches") %>
        </p>
      </div>
    <% end %>

    <!-- Max Delay -->
    <%# Only meaningful when something is actually being reposted; it used to
        render even with no other accounts paired. %>
    <% if @other_accounts.any? %>
    <div class="border rule p-5">
      <h2 class="text-sm font-medium text-gray-900 dark:text-white mb-4">
        <svg class="h-4 w-4 inline-block mr-1 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <%= t(".repost_delay") %>
      </h2>
      <div>
        <label for="max_delay_hours" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          <%= t(".max_delay") %>
        </label>
        <input type="number"
               id="max_delay_hours"
               name="max_delay_hours"
               value="<%= Scheduling::RepostSchedulerService::DEFAULT_MAX_DELAY_HOURS %>"
               min="1"
               max="168"
               class="w-32 rounded-lg border border-gray-200 dark:border-[color:var(--color-rule-dark)] bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 px-4 py-2 text-sm "
               data-post-scheduler-target="delayInput">
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
          <%= t(".max_delay_help") %>
        </p>
      </div>
    </div>
    <% end %>

    <!-- Existing Reposts -->
    <% if @existing_reposts.present? && @existing_reposts.any? %>
      <div class="border rule overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-[color:var(--color-rule-dark)]">
          <h2 class="text-sm font-medium text-gray-900 dark:text-white">
            <%= t(".existing_reposts") %>
            <span class="ml-1 text-gray-400">(<%= @existing_reposts.count %>)</span>
          </h2>
        </div>
        <ul class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @existing_reposts.each do |repost| %>
            <li class="px-6 py-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="h-7 w-7 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center flex-shrink-0">
                    <span class="text-gray-600 dark:text-gray-300 font-medium text-xs">
                      <%= repost.account.display_name_or_npub[0].upcase %>
                    </span>
                  </div>
                  <p class="text-sm text-gray-900 dark:text-white"><%= repost.account.display_name_or_npub %></p>
                </div>
                <div class="flex items-center gap-3">
                  <% if repost.scheduled_at.present? %>
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      <%= local_time(repost.scheduled_at, format: "short") %>
                    </span>
                  <% end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200">
                    <%= status_label(repost.status) %>
                  </span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Submit -->
    <div class="flex items-center justify-end gap-3">
      <%= link_to t(".cancel"), post_path(@post),
        class: "px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 border border-gray-300 dark:border-[color:var(--color-rule-dark)] rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" %>
      <button type="submit"
              class="inline-flex items-center gap-2 px-6 py-2 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
        <%= t(".sign_schedule") %>
      </button>
    </div>
  <% end %>
</div>
