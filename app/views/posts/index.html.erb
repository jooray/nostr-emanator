<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">All Posts</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Posts across all your accounts</p>
    </div>
  </div>

  <% if @posts.any? %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        <% @posts.each do |post| %>
          <li>
            <%= link_to post_path(post), class: "block px-4 py-4 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors" do %>
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-medium text-amber-600 dark:text-amber-400"><%= post.account.display_name_or_npub %></span>
                    <% status_colors = { "draft" => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300",
                                         "awaiting_signature" => "bg-orange-100 text-orange-800 dark:bg-orange-900 dark:text-orange-300",
                                         "scheduled" => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300",
                                         "publishing" => "bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-300",
                                         "published" => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300",
                                         "failed" => "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300" } %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= status_colors[post.status] || 'bg-gray-100 text-gray-800' %>">
                      <%= post.status.humanize %>
                    </span>
                    <% if post.reposts.any? %>
                      <%
                        published_count = post.reposts.count { |r| r.published? }
                        failed_count = post.reposts.count { |r| r.failed? }
                        pending_count = post.reposts.count { |r| !r.published? && !r.failed? }
                        parts = []
                        parts << pluralize(published_count, "repost") if published_count > 0
                        parts << "#{pending_count} scheduled" if pending_count > 0
                        parts << "#{failed_count} failed" if failed_count > 0
                      %>
                      <span class="text-xs text-gray-400 dark:text-gray-500">
                        <% if failed_count > 0 && published_count > 0 %>
                          <%= parts.join(", ") %>
                        <% elsif failed_count > 0 && published_count == 0 %>
                          <%= pluralize(failed_count, "failed repost") %>
                        <% elsif pending_count > 0 && published_count > 0 %>
                          <%= parts.join(", ") %>
                        <% elsif pending_count > 0 %>
                          <%= pluralize(pending_count, "scheduled repost") %>
                        <% else %>
                          <%= pluralize(published_count, "repost") %>
                        <% end %>
                      </span>
                      <% if failed_count > 0 %>
                        <span class="inline-flex items-center w-1.5 h-1.5 rounded-full bg-red-500" title="<%= pluralize(failed_count, 'repost') %> failed"></span>
                      <% end %>
                    <% end %>
                  </div>
                  <p class="text-sm text-gray-900 dark:text-gray-100 line-clamp-2"><%= render_nostr_content(truncate(post.content, length: 200)) %></p>
                </div>
                <div class="flex-shrink-0 text-right text-xs text-gray-500 dark:text-gray-400">
                  <% if post.scheduled_at %>
                    <p><%= local_time(post.scheduled_at, format: "date") %></p>
                    <p><%= local_time(post.scheduled_at, format: "time") %></p>
                  <% else %>
                    <p><%= local_time(post.created_at, format: "date") %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <% if @posts.respond_to?(:total_pages) && @posts.total_pages > 1 %>
      <nav class="flex justify-center">
        <%= paginate @posts %>
      </nav>
    <% end %>
  <% else %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-12 text-center border border-gray-200 dark:border-gray-700">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-white">No posts yet</h3>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        Create your first post from one of your paired accounts.
      </p>
    </div>
  <% end %>
</div>
