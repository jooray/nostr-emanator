        </div>
        <div class="tour-phones" aria-label="Emanator on mobile">
          <figure>
            <div class="device">
              <img class="shot-light" src="/landing/shots/newpost-mobile-light.png" width="487" height="773" alt="Composing a new post on Emanator mobile, with an AI generation prompt below the editor">
              <img class="shot-dark" src="/landing/shots/newpost-mobile-dark.png" width="487" height="773" alt="Composing a new post on Emanator mobile in dark theme">
            </div>
            <figcaption>Compose</figcaption>
          </figure>
          <figure>
            <div class="device">
              <img class="shot-light" src="/landing/shots/schedule-mobile-light.png" width="476" height="811" alt="Picking a publish date and time on Emanator mobile, with accounts to repost from listed below">
              <img class="shot-dark" src="/landing/shots/schedule-mobile-dark.png" width="476" height="811" alt="Picking a publish date and time on Emanator mobile in dark theme">
            </div>
            <figcaption>Schedule</figcaption>
          </figure>
          <figure>
            <div class="device">
              <img class="shot-light" src="/landing/shots/calendar-mobile-light.png" width="485" height="797" alt="Emanator calendar on mobile showing the month with scheduled posts">
              <img class="shot-dark" src="/landing/shots/calendar-mobile-dark.png" width="485" height="797" alt="Emanator calendar on mobile in dark theme">
