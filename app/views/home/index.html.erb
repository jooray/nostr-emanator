    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow">Scheduling for Nostr</div>
          <h1 id="hero-title">Give every identity a <span class="accent-word">head start.</span></h1>
          <p>
            A new Nostr account starts with no audience. Emanator lets the accounts you already run give it a push: write a post once, schedule when it goes out, and line up reposts from your other accounts to follow.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/auth/nostr">
              Launch app
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
