              <h3><%= t(".install.native_title") %></h3>
              <p><%= t(".install.native_body") %></p>
            <% end %>
            <div class="install-links">
              <% if AndroidApp.zapstore_published? %>
                <a class="button button-primary" href="<%= AndroidApp.zapstore_url %>" rel="noopener"><%= t(".install.zapstore") %></a>
