    <footer class="shell">
      <a class="brand" href="#main" aria-label="Back to top">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="12" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path d="m8 11 8-4M8 13l8 4"></path></svg>
        </span>
        Emanator
      </a>
      <span>Post scheduling for the open social web.</span>
    </footer>

    <script>
      (function () {
        var root = document.documentElement
        var button = document.querySelector(".theme-toggle")
        var systemDark = window.matchMedia("(prefers-color-scheme: dark)")

        function currentTheme() {
          return root.dataset.theme || (systemDark.matches ? "dark" : "light")
        }

        function updateLabel() {
          button.setAttribute("aria-label", "Switch to " + (currentTheme() === "dark" ? "light" : "dark") + " mode")
        }

        button.addEventListener("click", function () {
          var nextTheme = currentTheme() === "dark" ? "light" : "dark"
          root.dataset.theme = nextTheme
          try {
            localStorage.setItem("emanator-landing-theme", nextTheme)
          } catch (_) {}
          updateLabel()
        })

        if (systemDark.addEventListener) {
          systemDark.addEventListener("change", updateLabel)
        }
        updateLabel()
      })()
    </script>
  </body>
