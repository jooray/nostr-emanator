            </div>
            <% if @android_visitor %>
              <p class="install-note"><%= t(".install.web_too") %></p>
            <% end %>
            <a class="install-more" href="<%= android_app_path %>"><%= t(".install.more") %></a>
          </article>
        <% end %>
        <div class="install-grid">
          <% if @android_visitor %>
            <%= native_card %>
            <%= web_card %>
          <% else %>
            <%= web_card %>
            <%= native_card %>
          <% end %>
        </div>
      </section>

