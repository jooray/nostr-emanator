<div class="max-w-md mx-auto px-4 py-16 text-center space-y-6">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t(".title") %></h1>
  <p class="text-sm text-gray-600 dark:text-gray-300"><%= t(".body") %></p>
  <%# The app registers the emanator:// scheme; a browser without the app just
      does nothing on tap, which is why the web link sits underneath. %>
  <a href="emanator://billing" class="inline-flex justify-center items-center px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition-colors">
    <%= t(".open_app") %>
  </a>
  <p class="text-xs text-gray-500 dark:text-gray-400">
    <%= t(".web_hint") %> <%= link_to t(".web_link"), billing_path, class: "underline" %>
  </p>
</div>
